---
import T from "../../components/T.astro";
import Icon from "../../components/Icon.astro";
import type { Content } from "../../core/fields";
import type { PageData } from "../../core/types";
import mod from "./module";

interface Props { content: Content<typeof mod.fields>; data: PageData }
const { content: c, data } = Astro.props;
const email = data.settings.contacts.email.value;
const hasCv = Boolean(data.settings.cv.fileKey);
const caption = hasCv ? c.heading : data.settings.site.navContact;
---
{(email || hasCv) && (
<section class="about-contact">
  <div class="wrap contact-line">
    <T v={caption} f={mod.fields.heading} as="h2" class="contact-title" />
    <div class="contact-actions">
      {email && <a class="contact-email" href={"mailto:" + email}>{email}<Icon name="arrow-right" size={17} /></a>}
      {hasCv && <a class="contact-cv" href="/cv" download>{c.cvButton.value}<Icon name="download" size={17} /></a>}
    </div>
  </div>
</section>
)}
<style>
  .about-contact { background: var(--workbench-mat); color: var(--workbench-ink); padding-block: clamp(37px, 6vw, 72px) clamp(24px, 3vw, 44px); }
  .contact-line { display: flex; justify-content: space-between; align-items: baseline; gap: 18px 32px; flex-wrap: wrap; }
  .about-contact :global(.contact-title) { font-size: clamp(1.65rem, 3.9vw, 3.35rem); font-weight: 760; line-height: 1.05; }
  .contact-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 24px; min-width: 0; }
  .contact-actions a { min-height: 44px; display: inline-flex; align-items: center; gap: 9px; font: 650 var(--size-s) var(--font-display); text-decoration: none; overflow-wrap: anywhere; }
  .contact-actions a:hover { text-decoration: underline; text-decoration-color: var(--sun); }
  .contact-actions :global(svg) { color: var(--sun); flex: none; }
</style>

