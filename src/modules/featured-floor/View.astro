---
import T from "../../components/T.astro";
import Img from "../../components/Img.astro";
import Icon from "../../components/Icon.astro";
import type { Content, ImageValue } from "../../core/fields";
import { buildFields } from "../../core/build-fields";
import type { PageData } from "../../core/types";
import heroModule from "../home-hero/module";
import toolsModule from "../own-tools/module";
import mod from "./module";
import { scatter } from "./scatter";

interface Props {
  content: Content<typeof mod.fields>;
  data: PageData;
  sectionId: string;
  tools?: Content<typeof toolsModule.fields>;
  hero?: { content: Content<typeof heroModule.fields>; sectionId: string };
}
const { content: c, data, sectionId, hero, tools } = Astro.props;
const builds = data.builds.filter((b) => b.meta.featured).sort((a, b) => a.meta.homeOrder - b.meta.homeOrder).slice(0, 6);
const stops = scatter(builds.map((b) => ({ slug: b.slug, nudgeX: b.meta.floorNudgeX, nudgeY: b.meta.floorNudgeY })));
const n = builds.length;
const after = sectionId + "-after";
const number = (i: number) => String(i + 1).padStart(2, "0");
const published = (value: string) => value.trim() && !value.match(/^\[.*\]$/) ? value : "";
const hasImage = (image: ImageValue) => !!(image.mediaId && image.key);
const scans = hero?.content.pages.flatMap(({ scan }, i) => scan.mediaId ? [{ scan, path: `pages[${i}].scan` }] : []) ?? [];
const edit = data.mode === "draft";
const artwork = builds.map((b) => {
  const { floorImage, selectorImage, kind, title } = b.meta;
  if (kind === "hardware") return { image: hasImage(floorImage) ? floorImage : selectorImage, device: null };
  const name = title.value.toLowerCase();
  const tool = tools && [tools.first, tools.second].find((item) => {
    const label = item.name.value.toLowerCase();
    return label && (name === label || name.startsWith(label + " ")) && hasImage(item.image);
  });
  const image = tool?.image ?? (hasImage(floorImage) ? floorImage : selectorImage);
  return {
    image: hasImage(image) ? { ...image, mode: "fit" as const } : image,
    device: b.slug.includes("chronos") ? "laptop" : "tablet",
  };
});
---
{n === 0 ? (
  <section class="floor-empty ground-desk"><div class="wrap"><T v={c.emptyNote} f={mod.fields.emptyNote} editPath="emptyNote" /></div></section>
) : (
  <section id="featured" class="workbench" data-workbench style={`--stops:${n}`} aria-label={c.stageLabel.value}>
    <div class="stage" data-stage tabindex="-1">
      {hero && <div class="identity" data-edit-section={data.mode === "draft" ? hero.sectionId : undefined}>
        <T v={hero.content.headline} f={heroModule.fields.headline} as="h1" editPath="headline" />
        <T v={hero.content.line} f={heroModule.fields.line} editPath="line" />
      </div>}
      <div class="scene" data-scene>
        <div class="world" data-world>
          <div class="mat"></div>
          {scans.slice(0, 6).map(({ scan, path }, i) => <div class="work-scan" style={"--scan:" + i} data-edit-section={edit ? hero?.sectionId : undefined}>
            <Img v={scan} f={heroModule.fields.pages.of.scan} sizes="180px" editPath={path} />
          </div>)}
          {c.showWatch && n > 1 && <div class="bench-watch" role="img" aria-label={c.watchLabel.value} data-watch data-edit-path={edit ? "watchLabel" : undefined} data-edit-attribute={edit ? "aria-label" : undefined}>
            <span class="watch-hand watch-hour" data-hour></span>
            <span class="watch-hand watch-minute" data-minute></span>
          </div>}
          {builds.map((b, i) => (
            <div class:list={["piece", i === 0 && "is-current"]} data-piece data-x={stops[i]!.x * 0.53} data-y={stops[i]!.y * 0.59}
              style={`--x:${stops[i]!.x * 0.53}px;--y:${stops[i]!.y * 0.59}px;--angle:${[-8, 11, -12, 7, -6, 12][i]}deg`}>
              <button type="button" class="piece-target" data-floor-go={i} tabindex="-1" aria-label={b.meta.title.value}>
                <div class:list={["piece-art", artwork[i]!.device, !hasImage(artwork[i]!.image) && "piece-missing"]}>
                  <Img v={artwork[i]!.image} f={buildFields.floorImage} sizes="(max-width: 720px) 70vw, 520px" eager={i < 3} ratio={artwork[i]!.device ? "16 / 10" : "4 / 3"} />
                </div>
                <span aria-hidden="true" class="piece-tag">{number(i)}</span>
              </button>
            </div>
          ))}
          {hero?.content.showCoffee && <div class="coffee" aria-hidden="true"></div>}
        </div>
        <span class="reticle" aria-hidden="true"></span>
      </div>

      <div class="specs">
        {builds.map((b) => {
          const date = published(b.meta.built.value) || published(b.meta.year.value);
          const facts = [published(b.meta.madeWith.value), ...b.meta.skills.map((skill) => skill.name.value)].filter(Boolean);
          return <article class="spec" data-spec>
            <p class="spec-type" data-edit-path={edit ? b.meta.kind === "software" ? "software" : "hardware" : undefined}>{b.meta.kind === "software" ? c.software.value : c.hardware.value}{date && <span>{date}</span>}</p>
            <T v={b.meta.title} f={buildFields.title} as="h2" />
            {published(b.meta.summary.value) && <T v={b.meta.summary} f={buildFields.summary} />}
            {facts.length > 0 && <ul class="spec-facts">
              {[...new Set(facts)].slice(0, 3).map((value) => <li>{value}</li>)}
            </ul>}
            <a class="project-link" href={`/builds/${b.slug}`} data-edit-path={edit ? "viewButton" : undefined}>{c.viewButton.value}<Icon name="arrow-right" size={16} /><span class="sr-only"> {b.meta.title.value}</span></a>
          </article>;
        })}
      </div>

      <div class="floor-controls" data-floor-controls hidden>
        <div class="floor-navigation" role="group" aria-label={c.stageLabel.value}>
          <button type="button" class="floor-arrow" data-floor-prev aria-label={c.prevLabel.value} aria-disabled="true" data-edit-path={edit ? "prevLabel" : undefined} data-edit-attribute={edit ? "aria-label" : undefined}><Icon name="arrow-left" size={18} /></button>
          <ol class="stations">
            {builds.map((b, i) => <li><button type="button" data-floor-go={i} aria-current={i === 0 ? "step" : undefined} aria-label={b.meta.title.value}>{number(i)}</button></li>)}
          </ol>
          <p class="floor-count" aria-hidden="true"><span data-floor-count>01</span> / {number(n - 1)}</p>
          <button type="button" class="floor-arrow" data-floor-next aria-label={c.nextLabel.value} aria-disabled={n === 1 ? "true" : undefined} data-edit-path={edit ? "nextLabel" : undefined} data-edit-attribute={edit ? "aria-label" : undefined}><Icon name="arrow-right" size={18} /></button>
        </div>
        <p class="floor-hint" data-floor-hint data-edit-path={edit ? "keysHint" : undefined}>{c.keysHint.value}</p>
        <a class="floor-skip" href={`#${after}`} data-floor-skip data-edit-path={edit ? "skipLabel" : undefined}>{c.skipLabel.value}<Icon name="arrow-down" size={16} /></a>
        <p class="sr-only" data-floor-status aria-live="polite"></p>
      </div>
    </div>
  </section>
)}
<div id={after} tabindex="-1"></div>

<script>
  import { onPage } from "../../core/island";
  import { mountFloor } from "./island";
  onPage("[data-workbench]", mountFloor);
</script>

<style>
  .workbench { background: var(--workbench); color: var(--workbench-ink); position: relative; isolation: isolate; }
  .stage { position: relative; min-height: 100svh; padding: 110px var(--gutter) var(--space-6); }
  .identity, .specs, .floor-controls { position: relative; z-index: 2; }
  .identity :global(h1) { font-size: clamp(2.4rem, 4.9vw, 5rem); font-weight: 780; line-height: 0.95; letter-spacing: var(--track-tight); }
  .identity :global(p) { color: var(--workbench-subtle); margin-top: 12px; max-width: 33ch; line-height: 1.4; font-size: var(--size-s); }
  .scene { position: relative; height: 300px; pointer-events: none; overflow: clip; isolation: isolate; }
  .world { position: absolute; left: 50%; top: 52%; width: 0; height: 0; transform: translate3d(0, 0, 0) scale(.72); }
  .mat { position: absolute; inset: -1800px; background-color: var(--workbench-mat); background-image: var(--granite-tex-fine); box-shadow: inset 0 0 120px var(--shade-45); }
  .mat::before { content: ""; position: absolute; inset: 0; background-image: linear-gradient(to right, var(--workbench-grid) 1px, transparent 1px), linear-gradient(to bottom, var(--workbench-grid) 1px, transparent 1px); background-size: 88px 88px; }
  .scene::after { content: ""; position: absolute; inset: 0; background: radial-gradient(ellipse at 57% 51%, transparent 15%, var(--workbench) 88%); pointer-events: none; }
  .piece { position: absolute; left: var(--x); top: var(--y); width: 430px; translate: -50% -50%; rotate: var(--angle); opacity: .57; scale: .87; transition: opacity 360ms var(--ease-out), rotate 640ms var(--ease-out), scale 640ms var(--ease-out); }
  .piece.is-current { opacity: 1; scale: 1; rotate: calc(var(--angle) * .45); z-index: 1; }
  .piece-target { position: relative; display: block; width: 100%; background: none; border: 0; padding: 0; pointer-events: auto; cursor: pointer; }
  .piece-art { filter: drop-shadow(3px 8px 4px var(--shade-35)) drop-shadow(18px 30px 20px var(--shade-45)); }
  .piece-art :global(.img-fill), .piece-art :global(.img-fit) { border-radius: 7px; }
  .piece-art.tablet :global(.img-fit), .piece-art.laptop :global(.img-fit) { background: var(--obj-device); }
  .piece-art :global(.img-object img) { object-fit: contain; }
  .piece-art.tablet, .piece-art.laptop { background: var(--obj-device); border: 1px solid var(--workbench-subtle); padding: 11px; border-radius: 15px; }
  .piece-art.laptop::after { content: ""; position: absolute; left: -5%; width: 110%; height: 11px; top: calc(100% - 1px); background: var(--obj-shell-edge); border: 1px solid var(--workbench-subtle); border-radius: 2px 2px 12px 12px; }
  .piece-art :global(.img-empty) { color: var(--workbench-subtle); background: var(--workbench); border: 1px dashed var(--workbench-subtle); }
  .piece-tag { position: absolute; right: -19px; top: -18px; display: grid; place-items: center; width: 38px; height: 38px; border: 1px solid var(--workbench-rule); background: var(--workbench); color: var(--workbench-ink); font: 650 14px var(--font-display); font-variant-numeric: tabular-nums; }
  .piece.is-current .piece-tag { background: var(--sun); border-color: var(--sun); color: var(--black); }
  .reticle { position: absolute; z-index: 1; left: 50%; top: 52%; translate: -50% -50%; width: min(460px, 87%); height: min(330px, 90%); pointer-events: none; background:
    linear-gradient(var(--sun), var(--sun)) 0 0 / 18px 1px,
    linear-gradient(var(--sun), var(--sun)) 0 0 / 1px 18px,
    linear-gradient(var(--sun), var(--sun)) 100% 100% / 18px 1px,
    linear-gradient(var(--sun), var(--sun)) 100% 100% / 1px 18px; background-repeat: no-repeat; }
  .work-scan { position: absolute; width: 135px; left: calc(270px + var(--scan) * 100px); top: calc(-240px + var(--scan) * 28px); rotate: calc(-13deg + var(--scan) * 9deg); box-shadow: var(--shadow-object); pointer-events: none; }
  .work-scan :global(.img-slot) { border-radius: 2px; }
  .work-scan[data-edit-section] { pointer-events: auto; }
  .bench-watch { position: absolute; top: 258px; left: 192px; width: 64px; aspect-ratio: 1; background: var(--obj-device); border-radius: 50%; border: 3px solid var(--workbench-subtle); rotate: -23deg; box-shadow: 4px 7px 12px var(--shade-45); }
  .bench-watch::before { content: ""; position: absolute; z-index: -1; inset: -26px 12px; border-radius: 6px; background: var(--obj-strap); }
  .watch-hand { position: absolute; width: 2px; height: 28%; left: 50%; bottom: 50%; transform-origin: center bottom; background: var(--workbench-ink); }
  .watch-hour { height: 20%; background: var(--sun); }
  .coffee { position: absolute; left: -340px; top: -154px; width: 82px; aspect-ratio: 1; border: 4px solid var(--obj-paper); border-radius: 50%; background: var(--obj-coffee); box-shadow: inset 0 0 0 5px var(--obj-espresso), 6px 10px 14px var(--shade-45); }
  .coffee::after { content: ""; position: absolute; top: 49%; right: -17px; width: 16px; height: 16px; border: 4px solid var(--obj-paper); border-radius: 4px 9px 9px 4px; }
  .specs { display: grid; gap: var(--space-7); }
  .spec { max-width: 38ch; padding: 15px 0 0; border-top: 1px solid var(--workbench-rule); }
  .spec[hidden] { display: none; }
  .spec-type { display: flex; flex-wrap: wrap; gap: 3px 11px; color: var(--workbench-subtle); font-weight: 650; font-size: var(--size-xs); }
  .spec-type span { padding-left: 11px; border-left: 1px solid var(--workbench-rule); font-variant-numeric: tabular-nums; }
  .spec :global(h2) { margin-top: 7px; font-size: clamp(2rem, 3.4vw, 3.8rem); font-weight: 760; line-height: .96; letter-spacing: var(--track-tight); text-wrap: balance; overflow-wrap: anywhere; }
  .spec :global(.r-body) { font-size: var(--size-s); line-height: 1.45; margin-top: 12px; color: var(--workbench-subtle); }
  .spec-facts { display: grid; gap: 4px; margin-top: 11px; font-size: var(--size-xs); line-height: 1.35; }
  .spec-facts li { display: flex; gap: 8px; align-items: baseline; }
  .spec-facts li::before { content: ""; flex: 0 0 7px; border-top: 1px solid var(--sun); align-self: center; }
  .project-link, .floor-skip { display: inline-flex; align-items: center; gap: 9px; min-height: 44px; text-decoration: none; font-family: var(--font-display); font-weight: 650; font-size: var(--size-xs); }
  .project-link { margin-top: 5px; color: var(--workbench-ink); }
  .project-link:hover, .floor-skip:hover { text-decoration: underline; text-decoration-color: var(--sun); }
  .project-link :global(svg) { color: var(--sun); }
  .floor-controls { grid-template-columns: auto 1fr auto; align-items: center; gap: 18px; border-top: 1px solid var(--workbench-rule); }
  .floor-controls:not([hidden]) { display: grid; }
  .floor-count { display: none; font: 650 var(--size-xs) var(--font-display); font-variant-numeric: tabular-nums; color: var(--workbench-subtle); }
  .floor-count span { color: var(--sun); }
  .floor-navigation, .stations { display: flex; align-items: center; }
  .floor-navigation button { min-width: 44px; min-height: 44px; display: grid; place-items: center; border: 0; background: transparent; color: var(--workbench-subtle); cursor: pointer; font: 660 var(--size-xs) var(--font-display); font-variant-numeric: tabular-nums; }
  .floor-navigation button:hover { color: var(--white); }
  .floor-navigation button[aria-current] { color: var(--sun); box-shadow: inset 0 2px var(--sun); }
  .floor-navigation button[aria-disabled="true"] { opacity: .42; cursor: default; }
  .floor-hint, .floor-skip { color: var(--workbench-subtle); font-size: var(--size-xs); line-height: 1.25; }
  .floor-skip { justify-self: end; }
  .floor-empty { padding: 48px 0 72px; color: var(--muted); }

  .workbench[data-ready] .stage { height: 100svh; min-height: 0; padding: 0; }
  .workbench[data-pinned] { height: calc(100svh + (var(--stops) - 1) * 60svh + 35svh); }
  .workbench[data-pinned] .stage { position: sticky; top: 0; overflow: clip; }
  .workbench[data-ready] .identity { position: absolute; top: clamp(92px, 15svh, 155px); left: max(var(--gutter), calc((100% - var(--container)) / 2)); max-width: 35vw; pointer-events: none; }
  .workbench[data-ready] .identity[data-edit-section] { pointer-events: auto; }
  .workbench[data-ready] .scene { position: absolute; inset: 65px 0 48px 27%; height: auto; mask-image: linear-gradient(to right, transparent, black 12%); }
  .workbench[data-ready] .specs { position: absolute; left: max(var(--gutter), calc((100% - var(--container)) / 2)); bottom: clamp(78px, 15svh, 150px); width: min(32vw, 370px); }
  .workbench[data-ready] .spec { position: relative; background: linear-gradient(to right, var(--workbench) 56%, transparent); }
  .workbench[data-ready] .spec:not([hidden]) { animation: reveal-spec 320ms var(--ease-out); }
  .workbench[data-ready] .spec::before { content: ""; position: absolute; top: -1px; left: 0; width: 28px; height: 1px; background: var(--sun); }
  @keyframes reveal-spec { from { opacity: .65; translate: 0 4px; } to { opacity: 1; translate: 0 0; } }
  .workbench[data-ready] .floor-controls { position: absolute; bottom: 14px; left: max(var(--gutter), calc((100% - var(--container)) / 2)); right: max(var(--gutter), calc((100% - var(--container)) / 2)); }
  [data-ready] .world { will-change: transform; }

  @media (max-width: 720px) {
    .workbench[data-ready] .stage { display: grid; grid-template-rows: auto minmax(104px, 1fr) auto auto; padding: 84px var(--gutter) 6px; }
    .workbench[data-ready] .identity, .workbench[data-ready] .specs, .workbench[data-ready] .floor-controls { position: relative; inset: auto; width: auto; max-width: none; }
    .identity :global(h1) { font-size: clamp(2rem, 10vw, 3.5rem); }
    .identity :global(p) { margin-top: 5px; max-width: 42ch; }
    .workbench[data-ready] .scene { position: relative; inset: auto; min-height: 0; margin-inline: calc(-1 * var(--gutter)); mask-image: none; }
    .workbench[data-ready] .spec { background: none; max-width: 100%; padding-top: 8px; }
    .spec :global(h2) { font-size: clamp(1.68rem, 7.2vw, 2.5rem); margin-top: 3px; }
    .spec :global(.r-body) { margin-top: 5px; font-size: var(--size-xs); }
    .spec-facts { margin-top: 5px; }
    .project-link { margin-top: 0; }
    .floor-controls { gap: 0; grid-template-columns: 1fr auto; }
    .floor-hint { display: none; }
    .floor-navigation button { min-width: clamp(29px, 9vw, 40px); }
    .floor-skip { max-width: 10ch; padding-left: 5px; }
    .floor-skip :global(svg) { display: none; }
    .reticle { width: 66%; height: 80%; }
  }
  @media (max-height: 690px) {
    .workbench[data-ready] .identity :global(p) { max-width: 42ch; }
    .workbench[data-ready] .spec-facts li:nth-child(n + 2) { display: none; }
  }
  @media (max-height: 580px) {
    .workbench[data-ready] .stage { display: grid; height: auto; min-height: 100svh; padding: 84px var(--gutter) 12px; grid-template-rows: auto minmax(155px, 32svh) auto auto; }
    .workbench[data-ready] .identity, .workbench[data-ready] .specs, .workbench[data-ready] .floor-controls { position: relative; inset: auto; width: auto; max-width: none; }
    .workbench[data-ready] .scene { position: relative; inset: auto; min-height: 0; mask-image: none; }
    .workbench[data-ready] .identity :global(h1) { font-size: 2rem; }
    .workbench[data-ready] .identity :global(p) { font-size: var(--size-xs); }
    .workbench[data-ready] .spec :global(h2) { font-size: 1.8rem; }
    .workbench[data-ready] .spec { background: none; }
  }
  @media (max-width: 360px) {
    .stations { display: none; }
    .floor-count { display: block; min-width: 45px; text-align: center; }
    .floor-navigation > button { min-width: 44px; }
  }
</style>
