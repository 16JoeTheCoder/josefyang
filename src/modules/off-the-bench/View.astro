---
import T from "../../components/T.astro";
import Icon from "../../components/Icon.astro";
import type { Content } from "../../core/fields";
import mod from "./module";

interface Props { content: Content<typeof mod.fields> }
const { content: c } = Astro.props;
const F = mod.fields;
---
<section class="about-personal">
  <div class="wrap personal-grid">
    <T v={c.heading} f={F.heading} as="h2" class="personal-title" />
    <ul class="personal-items">
      {c.items.map((item) => (
        <li>
          <Icon name={item.icon} size={21} />
          <T v={item.subheading} f={F.items.of.subheading} as="h3" />
          <T v={item.text} f={F.items.of.text} class="personal-caption" />
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .about-personal { background: var(--archive-paper); color: var(--workbench); padding-block: clamp(32px, 5vw, 68px) clamp(64px, 8vw, 112px); }
  .personal-grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); align-items: start; gap: clamp(30px, 7vw, 96px); }
  .about-personal :global(.personal-title) { font-size: clamp(2rem, 4.5vw, 3.8rem); font-weight: 760; line-height: 1.03; letter-spacing: var(--track-tight); text-wrap: pretty; }
  .personal-items { border-top: 1px solid var(--archive-rule); }
  .personal-items li { min-height: 70px; display: grid; grid-template-columns: 23px minmax(75px, 14ch) minmax(0, 1fr); gap: 9px 16px; align-items: baseline; padding-block: 15px; border-bottom: 1px solid var(--archive-rule); }
  .personal-items :global(svg) { color: var(--muted); align-self: center; }
  .personal-items :global(h3) { font-size: var(--size-m); line-height: 1.17; text-wrap: wrap; overflow-wrap: anywhere; }
  .personal-items :global(.personal-caption) { color: var(--muted); }
  @media (max-width: 820px) { .personal-grid { grid-template-columns: 1fr; gap: 17px; } }
  @media (max-width: 500px) {
    .personal-items li { grid-template-columns: 23px minmax(0, 1fr); }
    .personal-items :global(.personal-caption) { grid-column: 2; }
  }
</style>

