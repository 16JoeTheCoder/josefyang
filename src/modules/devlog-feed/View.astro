---
import T from "../../components/T.astro";
import Icon from "../../components/Icon.astro";
import type { Content } from "../../core/fields";
import type { DevlogEntry, PageData } from "../../core/types";
import { monthName, shortDate } from "../../lib/dates";
import mod from "./module";

interface Props { content: Content<typeof mod.fields>; data: PageData }
const { content: c, data } = Astro.props;
const entries = data.devlog.filter((entry) => entry.sites.includes("main"));
const groups = new Map<string, DevlogEntry[]>();
for (const entry of entries) {
  const month = entry.date.slice(0, 7);
  const group = groups.get(month);
  if (group) group.push(entry);
  else groups.set(month, [entry]);
}
const notes = new Map(data.settings.devlog.monthNotes.map((note) => [note.month.slice(0, 7), note.note.value]));
const projects = new Map(entries.flatMap((entry) => entry.build ? [[entry.build.slug, entry.build.title] as const] : []));
const categories = new Map(entries.flatMap((entry) => (entry.categoryTerms ?? []).map((term) => [term.slug, term.name] as const)));
const tags = new Map(entries.flatMap((entry) => (entry.tagTerms ?? []).map((term) => [term.slug, term.name] as const)));
const lead = entries[0];
const countLabel = (count: number) => count === 1 ? c.singular.value : c.plural.value;
---
<section class="log-archive" id="devlog-archive" data-devlog-archive aria-labelledby="devlog-archive-heading" data-singular={c.singular.value} data-plural={c.plural.value}>
  <div class="wrap">
    <div class="archive-heading">
      <h2 id="devlog-archive-heading" data-edit-path={Astro.locals.mode === "draft" ? "heading" : undefined}>{c.heading.value}</h2>
      {entries.length > 0 && <p class="result-count" data-result-count aria-live="polite">{entries.length} {countLabel(entries.length)}</p>}
    </div>
    {entries.length === 0 ? <T v={c.emptyNote} f={mod.fields.emptyNote} class="archive-empty" /> : (
      <>
        <form class="archive-controls" data-archive-controls hidden role="search" aria-label={c.filterLabel.value}>
          <label class="query"><span>{c.searchLabel.value}</span><span class="search-box"><svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="10.5" cy="10.5" r="5.5" /><path d="m15 15 5 5" /></svg><input type="search" name="q" autocomplete="off" placeholder={c.searchPlaceholder.value} maxlength="120" /></span></label>
          <label><span>{c.projectLabel.value}</span><select name="project">
            <option value="">{c.allProjects.value}</option>
            {[...projects].map(([slug, title]) => <option value={slug}>{title}</option>)}
          </select></label>
          <label><span>{c.typeLabel.value}</span><select name="type">
            <option value="">{c.allTypes.value}</option>
            <option value="note">{c.notesLabel.value}</option>
            <option value="article">{c.articlesLabel.value}</option>
          </select></label>
          <label><span>{c.categoryLabel.value}</span><select name="category"><option value="">{c.allCategories.value}</option>{[...categories].map(([slug, name]) => <option value={slug}>{name}</option>)}</select></label>
          <label><span>{c.tagLabel.value}</span><select name="tag"><option value="">{c.allTags.value}</option>{[...tags].map(([slug, name]) => <option value={slug}>{name}</option>)}</select></label>
          <button class="clear" type="reset">{c.clearLabel.value}</button>
        </form>

        <div class="archive-layout">
          <nav class="archive-months" aria-label={c.monthsLabel.value}>
            <p>{c.monthsLabel.value}</p>
            <ul>
              {[...groups.keys()].map((month) => <li data-month-link={month}><a href={`#log-month-${month}`}>{monthName(month)}</a></li>)}
            </ul>
          </nav>
          <div class="archive-feed">
            <p class="archive-empty" data-empty-results hidden>{c.noMatches.value}</p>
            {[...groups].map(([month, list]) => (
              <section class="archive-month" data-archive-month={month} id={`log-month-${month}`} aria-labelledby={`log-heading-${month}`}>
                <header>
                  <h3 id={`log-heading-${month}`}>{monthName(month)}</h3>
                  {notes.get(month) && <p>{notes.get(month)}</p>}
                </header>
                <ol>
                  {list.map((entry) => (
                    <li class="archive-row" id={`log-entry-${entry.slug}`} data-archive-row data-lead-candidate={entry.id === lead?.id ? "" : undefined} data-type={entry.type} data-categories={(entry.categoryTerms ?? []).map((t) => t.slug).join(" ")} data-tags={(entry.tagTerms ?? []).map((t) => t.slug).join(" ")}
                      data-project={entry.build?.slug ?? ""} data-failed={entry.build?.failed ? "1" : undefined}
                      data-search={`${entry.title} ${entry.excerpt} ${entry.build?.title ?? ""} ${entry.tags.join(" ")}`}>
                      <time datetime={entry.date}>{shortDate(entry.date)}</time>
                      <div class="archive-entry">
                        <p class="entry-kind">{entry.type === "note" ? c.noteLabel.value : c.articleLabel.value}{entry.build && <span>{entry.build.title}</span>}{(entry.categoryTerms ?? []).map((term) => <span>{term.name}</span>)}</p>
                        <h4><a href={`/devlog/${entry.slug}`} data-archive-entry-link>{entry.title}</a></h4>
                        {entry.excerpt && <p class="entry-excerpt">{entry.excerpt}</p>}
                      </div>
                      <a class="entry-arrow" href={`/devlog/${entry.slug}`} data-archive-entry-link tabindex="-1" aria-hidden="true"><Icon name="arrow-right" size={20} /></a>
                    </li>
                  ))}
                </ol>
              </section>
            ))}
          </div>
        </div>
      </>
    )}
  </div>
</section>
<script>
  import { onPage } from "../../core/island";
  import { mountArchive } from "./archive";
  onPage("[data-devlog-archive]", mountArchive);
</script>
<style>
  .log-archive { padding: clamp(36px, 6vw, 76px) 0 clamp(60px, 9vw, 130px); background: var(--archive-paper); color: var(--workbench); scroll-margin-top: 22px; }
  .archive-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; padding-block-end: 17px; border-bottom: 1px solid var(--archive-rule); }
  .archive-heading h2 { font: 830 clamp(2.2rem, 5vw, 4.1rem)/1 var(--font-display); letter-spacing: var(--track-tight); }
  .result-count { font-size: var(--size-s); color: var(--muted); font-variant-numeric: tabular-nums; }
  .archive-controls:not([hidden]) { display: grid; grid-template-columns: minmax(145px, 1.5fr) repeat(4, minmax(105px, 1fr)) auto; align-items: end; gap: 16px; margin-top: 20px; }
  .archive-controls label { display: grid; gap: 5px; color: var(--muted); font-family: var(--font-display); font-weight: 650; font-size: var(--size-xs); }
  .archive-controls input, .archive-controls select, .clear { min-height: 46px; font: inherit; font-size: 1rem; color: var(--workbench); min-width: 0; }
  .archive-controls input, .archive-controls select { width: 100%; border: 1px solid var(--archive-rule); border-radius: 4px; background: var(--white); }
  .archive-controls select { padding: 0 10px; }
  .search-box { position: relative; }
  .search-icon { position: absolute; top: 14px; left: 12px; pointer-events: none; }
  .archive-controls input { padding: 0 12px 0 38px; }
  .archive-controls input::placeholder { color: var(--muted); font-weight: 400; }
  .clear { border: 0; background: none; padding: 0 6px; color: var(--muted); cursor: pointer; text-decoration: underline; text-underline-offset: 4px; font-family: var(--font-display); font-size: var(--size-s); }
  .clear:hover { color: var(--workbench); text-decoration-color: var(--sun); }
  .archive-layout { display: grid; grid-template-columns: minmax(140px, 2fr) minmax(0, 10fr); gap: clamp(20px, 6vw, 90px); margin-top: clamp(40px, 6vw, 76px); }
  .archive-months { align-self: start; position: sticky; top: 26px; }
  .archive-months p { font: 750 var(--size-xs)/1.2 var(--font-display); color: var(--muted); padding-bottom: 10px; border-bottom: 1px solid var(--archive-rule); }
  .archive-months ul { max-height: 56svh; overflow-y: auto; margin-top: 7px; }
  .archive-months li a { display: flex; align-items: center; min-height: 44px; text-decoration: none; color: var(--muted); font-size: var(--size-s); }
  .archive-months a:hover, .archive-months a[aria-current] { color: var(--workbench); text-decoration: underline; text-decoration-color: var(--sun); text-underline-offset: 5px; }
  .archive-months[hidden], .archive-month[hidden], .archive-row[hidden], .archive-empty[hidden] { display: none; }
  .archive-month { scroll-margin-top: 22px; }
  .archive-month + .archive-month { margin-top: 35px; }
  .archive-month header { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 0 0 13px; border-bottom: 1px solid var(--workbench); }
  .archive-month header h3 { font: 780 clamp(1.2rem, 2vw, 1.65rem)/1.2 var(--font-display); letter-spacing: var(--track-display); }
  .archive-month header p { color: var(--muted); font-size: var(--size-s); text-align: end; }
  .archive-row { display: grid; grid-template-columns: 8.5ch minmax(0, 1fr) auto; align-items: start; gap: 12px 24px; padding: 19px 0; border-bottom: 1px solid var(--archive-rule); scroll-margin-top: 22px; }
  .archive-row time { font-variant-numeric: tabular-nums; color: var(--muted); font-size: var(--size-xs); margin-top: 2px; }
  .archive-row:target { background: color-mix(in srgb, var(--sun) 9%, transparent); }
  .archive-entry h4 { margin-top: 3px; font: 780 clamp(1.25rem, 2.4vw, 2.05rem)/1.12 var(--font-display); letter-spacing: var(--track-display); }
  .archive-entry h4 a { text-decoration: none; }
  .archive-entry h4 a:hover { text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--sun); }
  .entry-kind { display: flex; flex-wrap: wrap; gap: 4px 10px; color: var(--muted); font-size: var(--size-xs); }
  .entry-kind span { border-left: 1px solid var(--archive-rule); padding-left: 10px; }
  .entry-excerpt { max-width: 64ch; margin-top: 8px; color: var(--muted); font-size: var(--size-s); }
  .entry-source { display: inline-flex; align-items: center; min-height: 44px; font-family: var(--font-display); font-size: var(--size-xs); text-underline-offset: 4px; }
  .entry-source:hover { text-decoration-color: var(--sun); }
  .entry-arrow { display: grid; width: 44px; height: 44px; place-items: center; }
  .entry-arrow:hover { background: var(--white); }
  .archive-empty { color: var(--muted); padding-top: 20px; }
  @media (max-width: 920px) {
    .archive-controls:not([hidden]) { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 780px) {
    .archive-layout { grid-template-columns: 1fr; gap: 25px; }
    .archive-months { position: static; min-width: 0; }
    .archive-months ul { display: flex; flex-wrap: wrap; gap: 0 16px; max-height: none; overflow: visible; }
    .archive-months li a { min-height: 38px; }
  }
  @media (max-width: 600px) {
    .archive-controls:not([hidden]) { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .query { grid-column: 1 / -1; }
    .clear { justify-self: start; min-height: 44px; }
    .archive-layout { margin-top: 19px; }
    .archive-month header { align-items: start; flex-direction: column; }
    .archive-month header p { text-align: start; }
    .archive-row { grid-template-columns: minmax(0, 1fr) auto; gap: 4px 8px; }
    .archive-row time { grid-column: 1 / -1; }
    .archive-entry { grid-column: 1; }
    .entry-arrow { grid-column: 2; }
  }
</style>
