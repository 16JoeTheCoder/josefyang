---
import T from "../../components/T.astro";
import type { Content } from "../../core/fields";
import mod from "./module";

interface Props { content: Content<typeof mod.fields> }
const { content: c } = Astro.props;
const F = mod.fields;
---
<section class="about-origin">
  <div class="wrap origin-grid">
    <T v={c.heading} f={F.heading} as="h2" class="origin-title" />
    <div class="origin-text">{c.paragraphs.map((p) => <T v={p.text} f={F.paragraphs.of.text} />)}</div>
  </div>
</section>
<style>
  .about-origin { background: var(--archive-paper); color: var(--workbench); padding-block: clamp(56px, 8vw, 112px); }
  .origin-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(30px, 8vw, 112px); align-items: start; }
  .about-origin :global(.origin-title) { font-size: clamp(2.25rem, 5.2vw, 5rem); font-weight: 780; line-height: .99; letter-spacing: var(--track-tight); text-wrap: pretty; position: relative; padding-top: 20px; }
  .about-origin :global(.origin-title)::before { content: ""; position: absolute; width: 34px; height: 2px; left: 0; top: 0; background: var(--sun); }
  .origin-text { display: grid; gap: 17px; padding-top: 16px; }
  .origin-text :global(.r-body) { font-size: var(--lead); color: var(--muted); }
  @media (max-width: 760px) { .origin-grid { grid-template-columns: 1fr; gap: 14px; } .origin-text { padding-top: 0; } }
</style>

