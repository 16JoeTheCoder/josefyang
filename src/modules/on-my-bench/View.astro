---
import T from "../../components/T.astro";
import Img from "../../components/Img.astro";
import Icon from "../../components/Icon.astro";
import type { Content } from "../../core/fields";
import type { PageData } from "../../core/types";
import mod from "./module";

interface Props { content: Content<typeof mod.fields>; data: PageData; sectionId: string }
const { content: c, data, sectionId } = Astro.props;
const F = mod.fields;
const I = F.items.of;
const edit = data.mode === "draft";
const focus = c.focus === "" ? -1 : Number(c.focus);
const items = c.items.map((item, i) => ({ ...item, i, hasImage: !!(item.image.mediaId && item.image.key), focused: i === focus }));
const start = focus >= 0 && focus < items.length ? focus : 0;
const id = (i: number, part: string) => `${sectionId}-${part}-${i}`;
---
<section class="bench" id={sectionId} aria-labelledby={sectionId + "-heading"} data-bench>
  <div class="wrap bench-grid">
    <header class="bench-head">
      <T v={c.heading} f={F.heading} as="h2" id={sectionId + "-heading"} editPath="heading" class="bench-title" />
      <T v={c.line} f={F.line} editPath="line" class="bench-line" />
    </header>

    <div class="bench-tabs" role="tablist" aria-label={c.tabsLabel.value} aria-orientation="vertical" data-bench-tabs hidden>
      {items.map((item) => (
        <button type="button" role="tab" id={id(item.i, "tab")} aria-controls={id(item.i, "panel")}
          aria-selected={item.i === start ? "true" : "false"} tabindex={item.i === start ? 0 : -1} data-bench-tab={item.i}>
          <span class="bench-name">{item.name.value}</span>
          {item.focused && <span class="bench-focus">{c.focusLabel.value}</span>}
        </button>
      ))}
    </div>

    <div class="bench-panels" data-bench-panels>
      {items.map((item) => (
        <article class:list={["bench-panel", item.hasImage ? "has-image" : "text-only"]} id={id(item.i, "panel")}
          aria-labelledby={id(item.i, "name")} data-bench-panel={item.i} data-edit-path={edit ? `items[${item.i}]` : undefined}>
          {item.hasImage && <Img v={item.image} f={I.image} sizes="(max-width: 860px) 92vw, 640px" editPath={`items[${item.i}].image`} />}
          <div class="bench-copy">
            <h3 class="bench-panel-name" id={id(item.i, "name")}>
              {item.name.value}
              {item.focused && <span class="bench-focus">{c.focusLabel.value}</span>}
            </h3>
            <T v={item.text} f={I.text} editPath={`items[${item.i}].text`} class="bench-text" />
            {item.linkUrl && item.linkLabel.value && (
              <a class="bench-link" href={item.linkUrl} data-edit-path={edit ? `items[${item.i}].linkLabel` : undefined}>{item.linkLabel.value}<Icon name="arrow-right" size={17} /></a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import { onPage } from "../../core/island";

  onPage("[data-bench]", (root) => {
    const list = root.querySelector<HTMLElement>("[data-bench-tabs]");
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-bench-tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-bench-panel]")];
    if (!list || tabs.length < 2 || tabs.length !== panels.length) return;
    let current = Math.max(0, tabs.findIndex((tab) => tab.getAttribute("aria-selected") === "true"));

    const warm = (i: number) => panels[i]?.querySelectorAll("img").forEach((img) => { img.loading = "eager"; });
    const select = (i: number, focus: boolean) => {
      current = i;
      tabs.forEach((tab, k) => { tab.setAttribute("aria-selected", String(k === i)); tab.tabIndex = k === i ? 0 : -1; });
      panels.forEach((panel, k) => { panel.hidden = k !== i; });
      if (focus) tabs[i]!.focus();
    };
    const onClick = (event: Event) => select(tabs.indexOf(event.currentTarget as HTMLButtonElement), false);
    const onKey = (event: KeyboardEvent) => {
      const n = tabs.length;
      const next = ["ArrowDown", "ArrowRight"].includes(event.key) ? (current + 1) % n
        : ["ArrowUp", "ArrowLeft"].includes(event.key) ? (current - 1 + n) % n
        : event.key === "Home" ? 0 : event.key === "End" ? n - 1 : -1;
      if (next < 0) return;
      event.preventDefault();
      select(next, true);
    };
    const onIntent = (event: Event) => warm(tabs.indexOf(event.currentTarget as HTMLButtonElement));

    panels.forEach((panel) => { panel.setAttribute("role", "tabpanel"); panel.setAttribute("aria-labelledby", panel.id.replace("-panel-", "-tab-")); panel.tabIndex = 0; });
    list.hidden = false;
    root.setAttribute("data-ready", "");
    select(current, false);
    tabs.forEach((tab) => {
      tab.addEventListener("click", onClick);
      tab.addEventListener("keydown", onKey);
      tab.addEventListener("pointerenter", onIntent);
      tab.addEventListener("focus", onIntent);
    });
    return () => tabs.forEach((tab) => {
      tab.removeEventListener("click", onClick);
      tab.removeEventListener("keydown", onKey);
      tab.removeEventListener("pointerenter", onIntent);
      tab.removeEventListener("focus", onIntent);
    });
  });
</script>

<style>
  .bench { background: var(--white); color: var(--black); padding-block: var(--section-y); scroll-margin-top: var(--nav-h); }
  .bench-grid { display: grid; gap: var(--space-7) var(--space-8); }
  .bench-head :global(.bench-title) { font-size: var(--size-xxl); font-weight: 850; line-height: .92; letter-spacing: var(--track-tight); scroll-margin-top: calc(var(--nav-h) + var(--space-6)); }
  .bench-head :global(.bench-title:focus) { outline: none; }
  .bench-head :global(.bench-title:focus-visible) { outline: 2px solid var(--sun); outline-offset: 6px; }
  .bench-head :global(.bench-line) { margin-top: var(--space-4); max-width: 46ch; color: var(--muted); font-size: var(--lead); line-height: 1.5; }

  /* Without JavaScript: a plain typographic list with hairlines. */
  .bench-panels { display: grid; border-top: 1px solid var(--hairline); }
  .bench-panel { display: grid; gap: var(--space-5); padding-block: var(--space-6); border-bottom: 1px solid var(--hairline); }
  .bench-panel :global(.img-slot) { max-width: 520px; }
  .bench-panel-name { font-family: var(--font-display); font-size: var(--size-l); font-weight: 800; line-height: 1.05; letter-spacing: var(--track-display); display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-4); }
  .bench-panel :global(.bench-text) { margin-top: var(--space-3); max-width: 52ch; line-height: 1.6; color: var(--muted); }
  .bench-link { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; margin-top: var(--space-3); font-family: var(--font-display); font-weight: 700; text-decoration: underline; text-decoration-color: var(--sun); text-underline-offset: 5px; text-decoration-thickness: 2px; }
  .bench-link :global(svg) { color: var(--sun); transition: translate var(--dur-fast) var(--ease-out); }
  .bench-link:hover :global(svg) { translate: 3px 0; }
  .bench-focus { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-body); font-size: var(--size-xs); font-weight: 500; letter-spacing: 0; color: var(--muted); white-space: nowrap; }
  .bench-focus::before { content: ""; width: 8px; height: 8px; background: var(--sun); }

  /* With JavaScript: one stage, four selectors. */
  [data-ready] .bench-panels { border-top: 0; }
  [data-ready] .bench-panel { border-bottom: 0; padding: 0; align-content: start; }
  [data-ready] .bench-panel[hidden] { display: none; }
  [data-ready] .bench-panel:not([hidden]) { animation: bench-in 420ms var(--ease-out); }
  [data-ready] .bench-panel:focus-visible { outline: 2px solid var(--sun); outline-offset: 8px; border-radius: var(--radius-m); }
  [data-ready] .bench-panel-name { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  [data-ready] .bench-panel :global(.img-slot) { max-width: none; }
  [data-ready] .bench-panel :global(.bench-text) { margin-top: 0; font-size: var(--lead); color: var(--black); }
  [data-ready] .text-only { min-height: clamp(240px, 26vw, 340px); padding: clamp(28px, 4vw, 56px); background: var(--section); border-radius: var(--radius-l); align-content: stretch; }
  [data-ready] .text-only .bench-copy { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-5); height: 100%; }
  [data-ready] .text-only .bench-link { margin-top: auto; }
  [data-ready] .text-only :global(.bench-text) { font-family: var(--font-display); font-size: var(--size-l); font-weight: 560; line-height: 1.25; letter-spacing: -0.01em; max-width: 26ch; text-wrap: pretty; }
  @keyframes bench-in { from { opacity: 0; translate: 0 6px; } to { opacity: 1; translate: 0 0; } }

  .bench-tabs[hidden] { display: none; }
  .bench-tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 0 var(--space-4); align-content: start; border-top: 1px solid var(--hairline); }
  .bench-tabs button { position: relative; display: grid; align-content: center; gap: 2px; min-height: 64px; padding: var(--space-3) 0; border: 0; border-bottom: 1px solid var(--hairline); background: none; color: var(--muted); text-align: left; cursor: pointer; font: inherit; }
  .bench-tabs button::after { content: ""; position: absolute; left: 0; bottom: -1px; width: 0; height: 2px; background: var(--sun); transition: width 360ms var(--ease-out); }
  .bench-tabs button[aria-selected="true"] { color: var(--black); }
  .bench-tabs button[aria-selected="true"]::after { width: 40px; }
  .bench-tabs button:hover { color: var(--black); }
  .bench-tabs button:focus-visible { outline: 2px solid var(--sun); outline-offset: 2px; }
  .bench-name { font-family: var(--font-display); font-size: clamp(1.125rem, 0.9rem + 1vw, 1.5rem); font-weight: 800; line-height: 1.05; letter-spacing: var(--track-display); text-wrap: balance; }

  @media (min-width: 861px) {
    .bench-grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .bench-head { grid-column: 1 / -1; }
    .bench-panels { grid-column: 1 / -1; }
    [data-ready] .bench-panels { grid-column: 2; grid-row: 2; }
    .bench-tabs { grid-column: 1; grid-row: 2; grid-template-columns: 1fr; }
    .bench-tabs button { min-height: 84px; }
    .bench-name { font-size: var(--size-xl); font-stretch: 90%; line-height: .95; letter-spacing: var(--track-tight); }
    .bench-panel { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; }
    .bench-panel.text-only { grid-template-columns: minmax(0, 1fr); }
    [data-ready] .bench-panel { grid-template-columns: minmax(0, 1fr); }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-ready] .bench-panel:not([hidden]) { animation: none; }
    .bench-tabs button::after { transition: none; }
  }
</style>
