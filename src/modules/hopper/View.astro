---
import T from "../../components/T.astro";
import Img from "../../components/Img.astro";
import type { Content } from "../../core/fields";
import { buildFields } from "../../core/build-fields";
import type { PageData } from "../../core/types";
import mod from "./module";
interface Props { content: Content<typeof mod.fields>; data: PageData; sectionId: string }
const { content: c, data, sectionId } = Astro.props;
const F = mod.fields;
const failed = data.builds.filter((b) => b.meta.status === "failed");
/** Where tiles lie around the hopper on desktop: [left %, top %, rotation deg]. */
const SLOTS: [number, number, number][] = [[3, 6, -5], [7, 54, 3], [76, 14, 4], [72, 58, -3], [24, 72, 6], [52, 76, -4]];
const onStage = failed.slice(0, SLOTS.length);
const kind = (k: string) => (k === "software" ? c.software.value : c.hardware.value);
---
{failed.length === 0 ? (
  <section class="hop ground-granite-fine"><div class="wrap"><T v={c.emptyNote} f={F.emptyNote} class="hop-empty" /></div></section>
) : (
  <section class="hop ground-granite-fine" data-hopper>
    <div class="wrap hop-stage" data-stage role="group" aria-label={c.stageLabel.value}>
      {onStage.map((b, i) => (
        <button
          type="button"
          class="tile"
          data-tile={b.slug}
          style={`--l:${SLOTS[i]![0]}%;--t:${SLOTS[i]![1]}%;--r:${SLOTS[i]![2]}deg`}
          aria-describedby={`${sectionId}-hint`}
        >
          <Img v={b.meta.tileImage} f={buildFields.tileImage} sizes="220px" grey emptyLabel={false} />
          <span class="tile-name">{b.meta.title.value}</span>
        </button>
      ))}
      <div class="machine" data-mouth>
        <svg class="funnel" viewBox="0 0 220 180" aria-hidden="true">
          <rect x="0" y="0" width="220" height="8" fill="var(--sun)" />
          <path d="M0 8 H220 L135 120 V160 H85 V120 Z" fill="var(--black)" />
          <rect x="70" y="160" width="80" height="12" fill="var(--obj-strap)" />
        </svg>
        <div class="paper" data-paper aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
      </div>
      <button type="button" class="btn btn-secondary feed" data-feed>{c.feedButton.value}</button>
      <p class="sr-only" id={`${sectionId}-hint`}>{c.feedButton.value}</p>
    </div>

    <div class="slip-wrap" data-panel aria-live="polite">
      <div class="wrap">
        <p class="slip-wait" data-wait>{c.waiting.value}</p>
        {failed.map((b) => (
          <article class="slip" data-slip={b.slug} hidden>
            <div>
              <p class="slip-for">{c.printoutFor.value}</p>
              <h2 class="slip-name">{b.meta.title.value}</h2>
              <p class="slip-meta">{kind(b.meta.kind)}, {c.abandoned.value} {b.meta.failedOn.value}</p>
            </div>
            <div class="slip-body">
              <T v={c.brokeHeading} f={F.brokeHeading} as="h3" />
              <T v={b.meta.whatBroke} f={buildFields.whatBroke} />
              <T v={c.learnedHeading} f={F.learnedHeading} as="h3" />
              <T v={b.meta.whatLearned} f={buildFields.whatLearned} />
              <p class="slip-links">
                {b.meta.lessonUrl && <a class="link-u" href={b.meta.lessonUrl}>{c.lessonLink.value}</a>}
                <a class="link-u" href={`/builds/${b.slug}`}>{c.buildLink.value}</a>
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="wrap hop-list">
      {failed.map((b) => (
        <details class="li-slip">
          <summary><span class="li-name">{b.meta.title.value}</span><span class="li-meta">{kind(b.meta.kind)}, {c.abandoned.value} {b.meta.failedOn.value}</span></summary>
          <div class="slip-body">
            <T v={c.brokeHeading} f={F.brokeHeading} as="h3" />
            <T v={b.meta.whatBroke} f={buildFields.whatBroke} />
            <T v={c.learnedHeading} f={F.learnedHeading} as="h3" />
            <T v={b.meta.whatLearned} f={buildFields.whatLearned} />
            <p class="slip-links">
              {b.meta.lessonUrl && <a class="link-u" href={b.meta.lessonUrl}>{c.lessonLink.value}</a>}
              <a class="link-u" href={`/builds/${b.slug}`}>{c.buildLink.value}</a>
            </p>
          </div>
        </details>
      ))}
    </div>
  </section>
)}
<script>
  import { onPage } from "../../core/island";
  import { mountHopper } from "./island";
  onPage("[data-hopper]", mountHopper);
</script>
<style>
  .hop { padding: 24px 0 var(--section-y); }
  .hop :global(.hop-empty) { color: var(--muted); padding: 48px 0; }

  /* Default (no JS / reduced motion): every slip as an expandable list item. */
  .hop-stage, .slip-wrap { display: none; }
  .li-slip { border-top: 1px solid var(--black); }
  .li-slip:last-child { border-bottom: 1px solid var(--black); }
  .li-slip summary { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding: 20px 0; cursor: pointer; min-height: 44px; list-style: none; }
  .li-slip summary::-webkit-details-marker { display: none; }
  .li-name { font-family: var(--font-display); font-weight: 900; font-size: var(--size-l); letter-spacing: -0.01em; }
  .li-meta { color: var(--muted); font-size: var(--size-s); align-self: center; }
  .li-slip .slip-body { padding: 0 0 28px; }

  .slip-body :global(h3) { margin-top: 0; }
  .slip-body :global(h3 ~ h3) { margin-top: 28px; }
  .slip-body :global(.r-body) { margin-top: 8px; color: var(--muted); }
  .slip-body :global(.r-body p + p) { margin-top: 0.8em; }
  .slip-links { display: flex; flex-wrap: wrap; gap: 24px; margin-top: 28px; font-family: var(--font-display); font-weight: 700; }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hop-list { display: none; }
    :global(.js) .hop-stage { display: block; position: relative; height: clamp(520px, 52vw, 680px); }
    :global(.js) .slip-wrap { display: block; background: var(--section); margin-top: 48px; padding: 64px 0 72px; }
  }

  .tile {
    position: absolute; left: var(--l); top: var(--t); width: clamp(150px, 15vw, 210px); rotate: var(--r);
    padding: 12px 12px 16px; background: var(--white); border: 0; border-radius: 4px; cursor: grab; text-align: left;
    box-shadow: var(--shadow-contact), 0 24px 30px -18px rgb(0 0 0 / 0.35);
    touch-action: none; user-select: none; -webkit-user-select: none;
    transition: box-shadow var(--dur-fast) var(--ease-out), outline-color var(--dur-fast) var(--ease-out);
    outline: 3px solid transparent; outline-offset: 0;
  }
  .tile:hover, .tile:focus-visible, .tile[aria-pressed="true"] { outline-color: var(--sun); box-shadow: var(--shadow-lift); }
  .tile.is-drag { cursor: grabbing; z-index: 5; }
  .tile :global(.img-slot) { border-radius: 2px; }
  .tile :global(.img-empty) { background: var(--tile); }
  .tile-name { display: block; margin-top: 10px; font-family: var(--font-display); font-weight: 800; font-size: 0.875rem; line-height: 1.2; }
  .machine { position: absolute; left: 50%; top: 22%; width: clamp(180px, 16vw, 220px); translate: -50% 0; }
  .funnel { width: 100%; height: auto; overflow: visible; }
  .paper { position: relative; width: 36%; margin: 0 auto; height: 40px; background: var(--white); box-shadow: var(--shadow-contact); display: flex; flex-direction: column; gap: 6px; padding: 12px 10px; overflow: hidden; }
  .paper i { display: block; height: 3px; background: var(--black); width: 80%; }
  .paper i:nth-child(3n) { width: 55%; }
  .feed { position: absolute; left: calc(50% + clamp(110px, 10vw, 140px)); top: 38%; background: var(--white); }

  .slip { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 56px; }
  .slip[hidden] { display: none; }
  .slip-wait { color: var(--muted); }
  .slip-for { font-size: var(--size-s); color: var(--muted); }
  .slip-name { margin-top: 10px; font-family: var(--font-display); font-weight: 900; font-size: var(--size-xl); line-height: 0.95; letter-spacing: var(--track-display); overflow-wrap: anywhere; }
  .slip-meta { margin-top: 14px; font-size: var(--size-s); }

  @media (max-width: 860px) {
    :global(.js) .hop-stage { height: auto; display: flex; flex-direction: column; align-items: center; gap: 20px; }
    .tile { position: relative; left: auto; top: auto; rotate: 0deg; width: 100%; display: grid; grid-template-columns: 72px 1fr; align-items: center; gap: 14px; padding: 10px; }
    .tile-name { margin: 0; font-size: 1rem; }
    .machine { position: relative; left: auto; top: auto; translate: none; order: -1; width: 180px; }
    .feed { position: static; order: -1; }
    .slip { grid-template-columns: 1fr; gap: 28px; }
  }
</style>
