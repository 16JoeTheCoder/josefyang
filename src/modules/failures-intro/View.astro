---
import T from "../../components/T.astro";
import type { Content } from "../../core/fields";
import mod from "./module";
interface Props { content: Content<typeof mod.fields> }
const { content: c } = Astro.props;
---
<header class="failure-intro">
  <div class="wrap failure-heading">
    <T v={c.heading} f={mod.fields.heading} as="h1" />
    <T v={c.line} f={mod.fields.line} />
  </div>
</header>
<style>
  .failure-intro { background: var(--workbench); color: var(--workbench-ink); padding-block: clamp(106px, 14vh, 149px) clamp(24px, 4vw, 51px); }
  .failure-heading { display: grid; grid-template-columns: 1.4fr .6fr; align-items: end; gap: 20px; }
  .failure-heading :global(h1) { font-size: clamp(3.3rem, 7vw, 6rem); font-weight: 780; line-height: .9; letter-spacing: var(--track-tight); text-wrap: balance; text-align: left; }
  .failure-heading :global(.r-body) { color: var(--workbench-subtle); max-width: 35ch; margin: 0 0 3px auto; line-height: 1.5; }
  @media (max-width: 720px) {
    .failure-heading { grid-template-columns: 1fr; gap: 14px; }
    .failure-heading :global(h1) { font-size: clamp(2.75rem, 13vw, 4.8rem); }
    .failure-heading :global(.r-body) { margin-inline: 0; }
  }
</style>
