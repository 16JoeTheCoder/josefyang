---
import T from "../../components/T.astro";
import type { Content } from "../../core/fields";
import mod from "./module";
interface Props { content: Content<typeof mod.fields> }
const { content: c } = Astro.props;
const F = mod.fields;
---
<header class="si ground-granite-fine">
  <div class="wrap">
    <nav class="si-crumb" aria-label={c.parentLabel.value}>
      {c.parentUrl ? <a class="link-u" href={c.parentUrl}>{c.parentLabel.value}</a> : <span>{c.parentLabel.value}</span>}
      <span aria-hidden="true">/</span>
      <span aria-current="page">{c.currentLabel.value}</span>
    </nav>
    <div class="si-grid">
      <T v={c.headline} f={F.headline} as="h1" class="si-title" />
      <div class="si-side">
        <T v={c.body} f={F.body} class="si-body" />
        {c.ctaUrl && <a class="btn btn-primary" href={c.ctaUrl}>{c.cta.value}<span class="si-arrow" aria-hidden="true"></span></a>}
      </div>
    </div>
  </div>
</header>
<style>
  .si { padding: calc(var(--nav-h) + var(--space-8)) 0 var(--space-7); }
  .si-crumb { display: flex; align-items: center; gap: var(--space-3); color: var(--muted); font-family: var(--font-display); font-weight: 700; font-size: var(--size-s); }
  .si-crumb a { display: inline-flex; align-items: center; min-height: 44px; }
  .si-grid { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); gap: var(--space-6); align-items: end; margin-top: var(--space-4); }
  .si-grid :global(.si-title) { font-stretch: 85%; overflow-wrap: anywhere; font-size: clamp(3.5rem, 1.6rem + 7.2vw, 9rem); }
  .si-side { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-5); padding-bottom: var(--space-2); }
  .si-side :global(.si-body) { font-size: var(--lead); line-height: 1.4; max-width: 31ch; }
  .si-arrow { width: 8px; height: 8px; border: solid currentColor; border-width: 0 1.5px 1.5px 0; transform: rotate(45deg); margin-top: -3px; }
  @media (max-width: 860px) {
    .si { padding-top: calc(var(--nav-h) + var(--space-6)); padding-bottom: var(--space-6); }
    .si-grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-5); }
  }
</style>
