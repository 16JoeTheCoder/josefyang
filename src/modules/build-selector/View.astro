---
import T from "../../components/T.astro";
import Img from "../../components/Img.astro";
import Icon from "../../components/Icon.astro";
import type { Content } from "../../core/fields";
import { buildFields as BF } from "../../core/build-fields";
import type { PageData } from "../../core/types";
import mod from "./module";

interface Props { content: Content<typeof mod.fields>; data: PageData; sectionId: string }
const { content: c, data, sectionId } = Astro.props;
const F = mod.fields;
const builds = data.builds;
const n = builds.length;
const bench = builds.find((build) => build.meta.status === "bench");
const failed = data.settings.site.failedPill.value;
const count = (i: number) => String(i).padStart(2, "0");
const known = (value: string) => value.trim() && !/^\[.*\]$/.test(value) ? value : "";
const kind = (type: string) => type === "software" ? c.software.value : c.hardware.value;
const editPath = (path: string) => data.mode === "draft" ? path : undefined;
const editKind = (type: string) => editPath(type === "software" ? "software" : "hardware");
const detailId = (slug: string) => sectionId + "-detail-" + slug;
---
<section class="selector" data-selector>
  <div class="gallery" data-gallery>
    <div class="wrap gallery-head">
      <T v={n > 1 ? c.heading : c.plainHeading} f={n > 1 ? F.heading : F.plainHeading} as="h1" editPath={n > 1 ? "heading" : "plainHeading"} />
      {bench && <p class="bench"><span data-edit-path={editPath("benchPrefix")}>{c.benchPrefix.value}</span> {bench.meta.title.value} <a href="/devlog" data-edit-path={editPath("benchLink")}>{c.benchLink.value}</a></p>}
    </div>
    {n === 0 ? <div class="wrap empty">
      <T v={c.emptyNote} f={F.emptyNote} editPath="emptyNote" />
      {c.emptyLink.value && <a class="gallery-link" href="/about" data-edit-path={editPath("emptyLink")}>{c.emptyLink.value}<Icon name="arrow-right" size={16} /></a>}
    </div> : (
      <>
        <div class="track" data-track tabindex="0" role="region" aria-label={c.heading.value} aria-describedby={n > 1 ? sectionId + "-hint" : undefined}>
          {builds.map((build, i) => {
            const { slug, meta } = build;
            const image = meta.selectorImage.mediaId ? meta.selectorImage : meta.floorImage;
            return <article class="slide" data-card data-slug={slug} data-index={i} data-active={i === 0 ? "" : undefined} id={`b-${slug}`}>
              <div class="slide-copy">
                <p class="slide-meta" data-edit-path={editKind(meta.kind)}>{kind(meta.kind)}{known(meta.year.value) && <span>{meta.year.value}</span>}{meta.status === "failed" && <span>{failed}</span>}</p>
                <h2>{meta.title.value}</h2>
                {known(meta.summary.value) && <T v={meta.summary} f={BF.summary} class="slide-summary" />}
                <a class="gallery-link" href={`#${detailId(slug)}`} data-select data-edit-path={editPath("selectButton")}>{c.selectButton.value}<Icon name="arrow-down" size={17} /></a>
              </div>
              <div class="slide-image">
                <Img v={image} f={BF.selectorImage} sizes="(max-width: 720px) 86vw, 850px" eager={i < 2} />
              </div>
            </article>;
          })}
        </div>
        {n > 1 && <div class="wrap gallery-controls" data-controls hidden>
          <p id={sectionId + "-hint"} class="gallery-hint" data-edit-path={editPath("hint")}>{c.hint.value}</p>
          <div class="gallery-navigation">
            <button type="button" data-prev aria-label={c.prevLabel.value} aria-disabled="true" data-edit-path={editPath("prevLabel")} data-edit-attribute={editPath("aria-label")}><Icon name="arrow-left" size={19} /></button>
            <p class="gallery-count" aria-live="polite"><strong data-pos>{count(1)}</strong> <span aria-hidden="true">/</span><span class="sr-only" data-edit-path={editPath("ofWord")}>{c.ofWord.value}</span> {count(n)}</p>
            <button type="button" data-next aria-label={c.nextLabel.value} data-edit-path={editPath("nextLabel")} data-edit-attribute={editPath("aria-label")}><Icon name="arrow-right" size={19} /></button>
          </div>
        </div>}
      </>
    )}
  </div>
  {n > 0 && <div class="details">
    {builds.map((b) => (
      <article class="wrap detail" id={detailId(b.slug)} data-detail tabindex="-1">
        <div>
          <p class="detail-type" data-edit-path={editKind(b.meta.kind)}>{kind(b.meta.kind)}{known(b.meta.built.value) && <span>{b.meta.built.value}</span>}</p>
          <h2>{b.meta.title.value}</h2>
          {known(b.meta.summary.value) && <T v={b.meta.summary} f={BF.summary} class="detail-summary" />}
        </div>
        <div class="detail-actions">
          {known(b.meta.madeWith.value) && <p>{b.meta.madeWith.value}</p>}
          {b.meta.skills.length > 0 && <ul>{b.meta.skills.map((skill) => <li>{skill.name.value}</li>)}</ul>}
          <a class="gallery-link" href={`/builds/${b.slug}`} data-edit-path={editPath("openButton")}>{c.openButton.value}<Icon name="arrow-right" size={17} /></a>
          <a class="gallery-link detail-return" href={"#b-" + b.slug} data-return data-edit-path={editPath("returnButton")}><Icon name="arrow-up" size={17} />{c.returnButton.value}</a>
        </div>
      </article>
    ))}
  </div>}
</section>
<script>
  import { onPage } from "../../core/island";
  import { mountSelector } from "./island";
  onPage("[data-selector]", mountSelector);
</script>
<style>
  .selector { background: var(--workbench); color: var(--workbench-ink); }
  .gallery { min-height: 100svh; padding: clamp(88px, 13vh, 132px) 0 22px; display: grid; align-content: center; gap: clamp(12px, 3vh, 31px); }
  .gallery-head { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 8px 24px; }
  .gallery-head :global(h1) { font-size: clamp(2.25rem, 4.9vw, 4.7rem); font-weight: 780; letter-spacing: var(--track-tight); line-height: .95; }
  .bench { color: var(--workbench-subtle); font-size: var(--size-s); }
  .bench a { color: var(--workbench-ink); margin-left: 6px; text-decoration-color: var(--sun); }
  .empty { display: grid; gap: 18px; justify-items: start; }
  .track { display: grid; margin-inline: auto; width: 100%; padding-inline: var(--gutter); max-width: calc(var(--container) + 2 * var(--gutter)); gap: 24px; }
  .slide { display: grid; position: relative; grid-template-columns: minmax(0, 3fr) minmax(0, 6fr); align-items: center; gap: clamp(24px, 4vw, 72px); min-width: 0; padding-block: 18px; border-block: 1px solid var(--workbench-rule); }
  .slide-copy { min-width: 0; }
  .slide-copy h2, .detail h2 { font-family: var(--font-display); font-weight: 785; font-size: clamp(2rem, 4.75vw, 4.75rem); letter-spacing: var(--track-tight); line-height: .98; overflow-wrap: anywhere; text-wrap: balance; margin-top: 5px; }
  .slide-meta, .detail-type { display: flex; flex-wrap: wrap; gap: 3px 12px; font-size: var(--size-xs); line-height: 1.35; color: var(--workbench-subtle); }
  .slide-meta span, .detail-type span { padding-left: 12px; border-left: 1px solid var(--workbench-rule); }
  .slide-copy :global(.slide-summary) { margin-top: 13px; line-height: 1.45; color: var(--workbench-subtle); }
  .slide-image { min-width: 0; overflow: hidden; background: var(--workbench-mat); border-radius: var(--radius-s); }
  .slide-image :global(.img-slot) { height: clamp(175px, 48svh, 570px); aspect-ratio: auto; border-radius: 0; background: var(--workbench-mat); }
  .slide-image :global(.img-slot img) { object-fit: contain; transform: none; }
  .slide-image :global(.img-empty) { color: var(--workbench-subtle); }
  .gallery-link { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; font: 700 var(--size-s) var(--font-display); text-decoration: none; }
  .slide-copy .gallery-link { margin-top: 12px; }
  .gallery-link :global(svg) { color: var(--sun); }
  .gallery-link:hover { text-decoration: underline; text-decoration-color: var(--sun); }
  .gallery-controls:not([hidden]) { display: flex; align-items: center; justify-content: space-between; gap: 14px; }
  .gallery-hint { color: var(--workbench-subtle); font-size: var(--size-xs); line-height: 1.35; }
  .gallery-navigation { display: flex; gap: 10px; align-items: center; }
  .gallery-navigation button { border: 1px solid var(--workbench-rule); background: transparent; width: 44px; height: 44px; display: grid; place-items: center; cursor: pointer; }
  .gallery-navigation button:hover { border-color: var(--sun); }
  .gallery-navigation button[aria-disabled="true"] { opacity: .42; cursor: default; }
  .gallery-count { min-width: 7ch; text-align: center; font: 560 var(--size-xs) var(--font-display); font-variant-numeric: tabular-nums; color: var(--workbench-subtle); }
  .gallery-count strong { color: var(--workbench-ink); }
  .selector[data-ready] .track { display: flex; overflow-x: auto; justify-content: flex-start; max-width: none; padding-inline: max(var(--gutter), calc((100vw - var(--container)) / 2)); scroll-padding-inline: max(var(--gutter), calc((100vw - var(--container)) / 2)); gap: 24px; scrollbar-width: none; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; }
  .selector[data-ready] .track:focus-visible { outline-offset: -2px; }
  .selector[data-ready] .slide { flex: 0 0 100%; scroll-snap-align: center; scroll-snap-stop: always; transition: opacity var(--dur-fast) var(--ease-out); cursor: pointer; }
  .selector[data-ready] .slide:not([data-active]) { opacity: .46; }
  .details { background: var(--archive-paper); color: var(--workbench); }
  .detail { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 3fr); gap: 32px; padding-block: clamp(52px, 9vw, 112px); }
  .detail[hidden] { display: none; }
  .detail:focus { outline: none; }
  .detail :global(.detail-summary), .detail-actions p { margin-top: 15px; color: var(--muted); }
  .detail-type { color: var(--muted); }
  .detail-actions ul { display: flex; flex-wrap: wrap; gap: 7px 16px; margin-top: 10px; font-size: var(--size-s); color: var(--muted); }
  .detail-actions .gallery-link { width: fit-content; display: flex; margin-top: 11px; border-bottom: 1px solid var(--archive-rule); }
  @media (max-width: 720px) {
    .gallery { padding-top: 88px; gap: 13px; }
    .gallery-head .bench { display: none; }
    .slide { grid-template-columns: 1fr; gap: 11px; padding-block: 10px; }
    .slide-image { order: -1; }
    .slide-image :global(.img-slot) { height: clamp(125px, 34svh, 330px); }
    .slide-copy h2 { font-size: clamp(1.8rem, 8vw, 3.6rem); }
    .slide-copy :global(.slide-summary) { margin-top: 5px; font-size: var(--size-xs); }
    .slide-copy .gallery-link { margin-top: 2px; }
    .detail { grid-template-columns: 1fr; gap: 12px; }
  }
  @media (max-height: 700px) and (min-width: 721px) {
    .gallery { padding-top: 86px; }
    .slide-image :global(.img-slot) { height: clamp(150px, 43svh, 440px); }
    .slide-copy h2 { font-size: clamp(1.7rem, 4.1vw, 3.4rem); }
  }
</style>
