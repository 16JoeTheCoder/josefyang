---
import T from "../../components/T.astro";
import Img from "../../components/Img.astro";
import Icon from "../../components/Icon.astro";
import type { Content } from "../../core/fields";
import { buildFields } from "../../core/build-fields";
import type { PageData } from "../../core/types";
import mod from "./module";
interface Props { content: Content<typeof mod.fields>; data: PageData }
const { content: c, data } = Astro.props;
const F = mod.fields;
const builds = data.builds;
const bench = builds.find((b) => b.meta.status === "bench");
const n = builds.length;
const one = n === 1 ? builds[0] : undefined;
const failed = data.settings.site.failedPill.value;
---
<section class="sel" data-selector data-count={n}>
  <div class="lamp" aria-hidden="true"></div>
  <div class="wrap sel-head">
    <T v={n >= 2 ? c.heading : c.plainHeading} f={n >= 2 ? F.heading : F.plainHeading} as="h1" />
    {bench && (
      <p class="sel-bench">{c.benchPrefix.value} {bench.meta.title.value}. <a class="link-u" href="/devlog">{c.benchLink.value}</a></p>
    )}
  </div>
  {n === 0 && (
    <div class="wrap sel-none">
      <T v={c.emptyNote} f={F.emptyNote} class="sel-empty" />
      {c.emptyLink.value && <a class="btn btn-sun btn-lg" href="/about">{c.emptyLink.value}</a>}
    </div>
  )}
  {n === 1 && (
    <div class="wrap sel-one">
      <div class="one-text">
        <h2 class="card-name one-name">{one!.meta.title.value}</h2>
        <T v={one!.meta.summary} f={buildFields.summary} class="one-sum" />
        <p class="card-meta">{one!.meta.kind === "software" ? c.software.value : c.hardware.value}, {one!.meta.year.value}</p>
        <a class="btn btn-sun btn-lg one-link" href={`/builds/${one!.slug}`}>{c.openButton.value}</a>
      </div>
      <a class="card-img one-img" href={`/builds/${one!.slug}`} tabindex="-1" aria-hidden="true">
        <Img v={one!.meta.selectorImage} f={buildFields.selectorImage} sizes="(max-width: 860px) 92vw, 1100px" eager />
        {one!.meta.status === "failed" && <span class="pill pill-failed card-failed">{failed}</span>}
      </a>
    </div>
  )}
  {n >= 2 && (
    <>
      <div class="sel-stage">
      <div class="sel-track" data-track tabindex="0" role="listbox" aria-label={c.heading.value} aria-describedby="sel-hint">
        {builds.map((b, i) => (
          <article class="card" id={`b-${b.slug}`} data-card data-slug={b.slug} data-index={i} role="option" aria-selected={i === 0 ? "true" : "false"}>
            <a class="card-img" href={`/builds/${b.slug}`} tabindex="-1" data-open>
              <Img v={b.meta.selectorImage} f={buildFields.selectorImage} sizes="(max-width: 860px) 84vw, 56vw" eager={i < 3} />
              {b.meta.status === "failed" && <span class="pill pill-failed card-failed">{failed}</span>}
            </a>
            <div class="card-info">
              <h2 class="card-name"><a href={`/builds/${b.slug}`} data-name-link>{b.meta.title.value}</a></h2>
              <T v={b.meta.summary} f={buildFields.summary} class="card-sum" />
              <p class="card-meta">{b.meta.kind === "software" ? c.software.value : c.hardware.value}, {b.meta.year.value}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="wrap sel-controls">
        <button class="icon-btn" type="button" data-prev aria-label={c.prevLabel.value}><Icon name="arrow-left" /></button>
        <a class="btn btn-sun btn-lg" data-lock href={`/builds/${builds[0]!.slug}`}>{c.openButton.value}</a>
        <button class="icon-btn" type="button" data-next aria-label={c.nextLabel.value}><Icon name="arrow-right" /></button>
      </div>
      <p class="wrap sel-hint" id="sel-hint">{c.hint.value} <span aria-live="polite"><span data-pos>1</span> {c.ofWord.value} {n}</span></p>
      </div>
      <div class="wrap sel-listwrap"><ul class="sel-list">
        {builds.map((b) => (
          <li class="li">
            <div class="li-top">
              <h2 class="li-name"><a href={`/builds/${b.slug}`}>{b.meta.title.value}</a></h2>
              {b.meta.status === "failed" && <span class="pill pill-failed">{failed}</span>}
            </div>
            <T v={b.meta.summary} f={buildFields.summary} class="li-sum" />
            <p class="li-meta">{b.meta.kind === "software" ? c.software.value : c.hardware.value}, {b.meta.year.value}</p>
            <a class="li-link link-u" href={`/builds/${b.slug}`}>{c.openButton.value}<span class="sr-only">: {b.meta.title.value}</span></a>
          </li>
        ))}
      </ul></div>
      <noscript><style is:global>{`.sel-stage{display:none!important}.sel-listwrap{display:block!important}`}</style></noscript>
    </>
  )}
</section>
<script>
  import { onPage } from "../../core/island";
  import { mountSelector } from "./island";
  onPage("[data-selector]", mountSelector);
</script>
<style>
  .sel { position: relative; overflow: hidden; background: var(--black); color: var(--white); padding: calc(var(--nav-h) + 72px) 0 var(--section-y); min-height: 100svh; }
  .lamp { position: absolute; left: 50%; top: 38%; width: 1400px; height: 1000px; translate: -50% -50%; background: radial-gradient(closest-side, var(--light-16), var(--light-05) 55%, transparent); pointer-events: none; }
  .sel-head { position: relative; display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; }
  .sel-head :global(h1) { font-size: var(--size-xxl); }
  .sel-bench { color: var(--muted-dark); font-size: var(--size-s); }
  .sel-bench a { color: var(--white); }
  .sel :global(.sel-empty) { margin-top: 48px; color: var(--muted-dark); }
  .sel-track {
    position: relative; display: flex; gap: 2vw; margin-top: 48px; overflow-x: auto; scroll-snap-type: x mandatory;
    padding-inline: 22vw; scrollbar-width: none; overscroll-behavior-x: contain; outline: none;
  }
  .sel-track::-webkit-scrollbar { display: none; }
  .sel-track:focus-visible .card[aria-selected="true"] .card-img { outline: 2px solid var(--sun); outline-offset: 6px; }
  .card { flex: 0 0 56vw; scroll-snap-align: center; transition: opacity 500ms var(--ease-out), transform 600ms var(--ease-out); }
  .card[aria-selected="false"] { opacity: 0.35; transform: scale(0.82); }
  .card-img { position: relative; display: block; border-radius: var(--radius-m); text-decoration: none; }
  .card-img :global(.img-empty) { background: var(--granite); }
  .card[aria-selected="true"] .card-img :global(.img-slot) { box-shadow: 0 40px 80px -30px var(--light-18); }
  .card-failed { position: absolute; top: 14px; left: 14px; background: var(--black); border-color: var(--muted-dark); }
  .card-info { text-align: center; margin-top: 32px; transition: opacity 400ms var(--ease-out); }
  .card[aria-selected="false"] .card-info { opacity: 0; }
  .card-name a { text-decoration: none; }
  .card-name { font-family: var(--font-display); font-weight: 900; font-stretch: 72%; font-size: var(--size-giant); line-height: 0.9; letter-spacing: var(--track-display); overflow-wrap: anywhere; text-wrap: balance; }
  .card :global(.card-sum) { margin: 16px auto 0; color: var(--muted-dark); max-width: 48ch; }
  .card-meta { margin-top: 10px; font-size: var(--size-s); }
  .sel-controls { display: flex; justify-content: center; align-items: center; gap: 16px; margin-top: 36px; }
  .icon-btn { width: 56px; height: 56px; display: grid; place-items: center; border-radius: var(--pill); border: 1.5px solid var(--muted-dark); background: transparent; color: var(--white); cursor: pointer; transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out); }
  .icon-btn:hover { background: var(--white); color: var(--black); }
  .icon-btn:disabled { opacity: 0.3; cursor: default; background: transparent; color: var(--white); }
  .btn-sun { background: var(--sun); color: var(--black); }
  .btn-sun:hover { background: var(--white); }
  .sel-hint { margin-top: 18px; text-align: center; font-size: var(--size-s); color: var(--muted-dark); }

  @media (max-width: 860px) {
    .sel-track { padding-inline: 8vw; gap: 4vw; }
    .card { flex-basis: 84vw; }
    .card[aria-selected="false"] { transform: scale(0.92); }
    .card-name { font-size: var(--size-xxl); }
  }
  .sel-none { display: grid; justify-items: start; gap: 28px; margin-top: 48px; }
  .sel :global(.sel-none .sel-empty) { margin-top: 0; }
  .sel-one { display: grid; gap: var(--space-7); margin-top: var(--space-7); position: relative; }
  .one-text { display: grid; justify-items: start; gap: 16px; max-width: 60ch; }
  .one-name { font-size: var(--size-xxl); }
  .sel :global(.one-sum) { color: var(--muted-dark); }
  .one-link { margin-top: 12px; }
  .one-img { max-width: 1100px; }
  .sel-listwrap { display: none; margin-top: var(--space-7); position: relative; }
  .sel-list { list-style: none; padding: 0; border-top: 1px solid var(--rule-dark); }
  .li { padding: var(--space-6) 0; border-bottom: 1px solid var(--rule-dark); display: grid; justify-items: start; gap: 10px; }
  .li-top { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .li-name { font-family: var(--font-display); font-weight: 900; font-stretch: 72%; font-size: var(--size-xl); line-height: 0.95; letter-spacing: var(--track-display); overflow-wrap: anywhere; }
  .li-name a { text-decoration: none; }
  .sel :global(.li-sum) { color: var(--muted-dark); max-width: 52ch; }
  .li-meta { font-size: var(--size-s); color: var(--muted-dark); }
  .li-link { display: inline-flex; align-items: center; min-height: 44px; font-family: var(--font-display); font-weight: 700; }

  /* Text-first list: small screens, reduced motion (and, via <noscript>, no JavaScript). */
  @media (max-width: 860px) {
    .sel-stage { display: none; }
    .sel-listwrap { display: block; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sel-stage { display: none; }
    .sel-listwrap { display: block; }
  }
</style>
