---
import T from "../../components/T.astro";
import Img from "../../components/Img.astro";
import Icon from "../../components/Icon.astro";
import type { Content } from "../../core/fields";
import type { PageData } from "../../core/types";
import { shortDate } from "../../lib/dates";
import mod from "./module";

interface Props { content: Content<typeof mod.fields>; data: PageData }
const { content: c, data } = Astro.props;
const F = mod.fields;
const latest = data.devlog.find((entry) => entry.sites.includes("main"));
const hasCover = !!latest?.hero?.mediaId;
const showNow = !!(c.nowDate && c.nowText.value.trim());
const latestLabel = c.latestLabel.value.replace(/[,:.]+$/, "");
---
<section class="log-intro">
  <div class="wrap">
    <header class="log-masthead">
      <T v={c.heading} f={F.heading} as="h1" editPath="heading" />
      <div class="log-description">
        <T v={c.line} f={F.line} editPath="line" />
        <a class="archive-jump" data-edit-path={Astro.locals.mode === "draft" ? "archiveLink" : undefined} href="#devlog-archive">{c.archiveLink.value}<Icon name="arrow-down" size={17} /></a>
      </div>
    </header>

    {latest ? (
      <div class="log-lead" data-devlog-featured={latest.slug} id={`featured-${latest.slug}`}>
        <div class="log-lead-text">
          <p class="log-meta">
            <span class="latest-mark">{latestLabel}</span>
            <time datetime={latest.date}>{shortDate(latest.date)}</time>
            {latest.readMinutes && <span>{latest.readMinutes} {c.minRead.value}</span>}
          </p>
          <h2><a href={`/devlog/${latest.slug}`} data-devlog-lead-link>{latest.title}</a></h2>
          {latest.excerpt && <p class="log-excerpt">{latest.excerpt}</p>}
          <a class="read-feature" href={`/devlog/${latest.slug}`} data-devlog-lead-link data-edit-path={Astro.locals.mode === "draft" ? "readLabel" : undefined}>{c.readLabel.value}<Icon name="arrow-right" size={18} /></a>
        </div>
        {hasCover && (
          <figure class="log-cover">
            <Img v={latest.hero} f={{ ratio: "16 / 9", empty: c.photoEmpty.value }} eager sizes="(max-width: 760px) 92vw, 680px" />
          </figure>
        )}
      </div>
    ) : (
      <aside class="log-empty"><T v={c.noEntries} f={F.noEntries} editPath="noEntries" /></aside>
    )}

    {showNow && (
      <div class="log-source">
        {showNow && <p class="log-now"><strong>{c.nowLabel.value}</strong><time datetime={c.nowDate}>{shortDate(c.nowDate)}</time><span>{c.nowText.value}</span></p>}
      </div>
    )}
  </div>
</section>
<style>
  .log-intro { padding: calc(var(--nav-h) + 52px) 0 clamp(34px, 6vw, 78px); background: var(--workbench); color: var(--workbench-ink); }
  .log-masthead { display: flex; align-items: end; justify-content: space-between; gap: 24px; padding-block-end: 25px; border-bottom: 1px solid var(--workbench-rule); }
  .log-masthead :global(h1) { font-size: clamp(3.6rem, 9vw, 6rem); font-weight: 850; line-height: .88; letter-spacing: var(--track-tight); }
  .log-description { display: grid; gap: 2px; justify-items: start; max-width: 34ch; }
  .log-description :global(.r-body) { color: var(--workbench-subtle); }
  .archive-jump, .read-feature, .log-source a { display: inline-flex; align-items: center; min-height: 44px; gap: 10px; width: fit-content; text-decoration: none; font-family: var(--font-display); font-size: var(--size-s); font-weight: 700; }
  .archive-jump :global(.icon), .read-feature :global(.icon), .log-source a :global(.icon) { color: var(--sun); }
  .archive-jump:hover, .read-feature:hover, .log-source a:hover { text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--sun); }
  .log-lead { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: center; gap: clamp(28px, 6vw, 92px); margin-top: clamp(32px, 5vw, 58px); scroll-margin-top: 24px; }
  .log-lead:not(:has(.log-cover)) { grid-template-columns: minmax(0, 1fr); }
  .log-lead h2 { max-width: 16ch; margin-top: 11px; font: 820 clamp(2rem, 4.6vw, 4.25rem)/.98 var(--font-display); letter-spacing: var(--track-tight); text-wrap: balance; }
  .log-lead h2 a { text-decoration: none; }
  .log-lead h2 a:hover { text-decoration: underline; text-decoration-color: var(--sun); text-underline-offset: .12em; text-decoration-thickness: .04em; }
  .log-meta { display: flex; align-items: baseline; flex-wrap: wrap; gap: 5px 13px; font-size: var(--size-xs); color: var(--workbench-subtle); }
  .latest-mark { display: inline-flex; align-items: center; gap: 7px; color: var(--workbench-ink); font-family: var(--font-display); font-weight: 700; }
  .latest-mark::before { content: ""; width: 7px; height: 7px; background: var(--sun); }
  .log-meta time, .log-now time { font-variant-numeric: tabular-nums; }
  .log-excerpt { max-width: 45ch; margin-top: 16px; color: var(--workbench-subtle); font-size: var(--size-m); line-height: 1.6; }
  .read-feature { margin-top: 14px; }
  .log-cover :global(.img-slot) { border-radius: 4px; background: var(--workbench-mat); }
  .log-cover :global(.img-fit) { background: var(--workbench-mat); }
  .log-source { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 4px 28px; margin-top: clamp(29px, 4vw, 42px); padding-top: 5px; border-top: 1px solid var(--workbench-rule); color: var(--workbench-subtle); }
  .log-source a:only-child { margin-left: auto; }
  .log-now { display: flex; flex-wrap: wrap; gap: 4px 10px; font-size: var(--size-s); }
  .log-now strong { color: var(--workbench-ink); font-family: var(--font-display); }
  .log-empty { margin-top: 32px; max-width: 48ch; }
  .log-empty :global(.r-body) { color: var(--workbench-subtle); margin-top: 8px; }
  @media (max-width: 760px) {
    .log-intro { padding-top: calc(var(--nav-h) + 34px); }
    .log-masthead { display: grid; gap: 12px; padding-bottom: 17px; }
    .log-lead { grid-template-columns: 1fr; gap: 18px; margin-top: 26px; }
    .log-lead h2 { max-width: 21ch; }
    .log-source a:only-child { margin-left: 0; }
  }
</style>
