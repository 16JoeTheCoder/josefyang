---
import T from "../../components/T.astro";
import Img from "../../components/Img.astro";
import type { Content } from "../../core/fields";
import type { PageData } from "../../core/types";
import { shortDate } from "../../lib/dates";
import mod from "./module";
interface Props { content: Content<typeof mod.fields>; data: PageData }
const { content: c, data } = Astro.props;
const F = mod.fields;
const latest = data.devlog[0];
const fuse = data.settings.contacts.fuseUrl;
const showNow = !!(c.nowDate && c.nowText.value.trim());
---
<section class="di">
  <div class="wrap di-top">
    <div>
      <T v={c.heading} f={F.heading} as="h1" />
      <T v={c.line} f={F.line} class="di-line" />
      {showNow && (
        <p class="di-now"><span class="di-now-tag">{c.nowLabel.value}</span><time datetime={c.nowDate}>{shortDate(c.nowDate)}</time><span class="di-now-text">{c.nowText.value}</span></p>
      )}
    </div>
    {fuse && (
      <aside class:list={["raw", !latest && "raw-next"]}>
        <T v={c.rawTitle} f={F.rawTitle} as="h2" />
        <T v={latest ? c.rawText : c.rawEmptyText} f={latest ? F.rawText : F.rawEmptyText} class="raw-text" />
        <a class="link-u raw-link" href={fuse} target="_blank" rel="noopener">{c.rawLink.value}</a>
      </aside>
    )}
  </div>
  {latest && (
    <div class="wrap">
      <a class="feat" href={`/devlog/${latest.slug}`}>
        <Img v={latest.hero} f={{ ratio: "16 / 10", empty: c.photoEmpty.value }} eager sizes="(max-width: 900px) 92vw, 700px" />
        <div class="feat-text">
          <p class="feat-label"><span class="dot" aria-hidden="true"></span>{c.latestLabel.value} {shortDate(latest.date)}</p>
          <h2 class="feat-title">{latest.title}</h2>
          <p class="feat-ex">{latest.excerpt}</p>
          <p class="feat-meta">
            {latest.build && <span class:list={["pill", latest.build.failed ? "pill-failed" : "pill-tag"]}>{latest.build.title}</span>}
            {latest.readMinutes && <span>{latest.readMinutes} {c.minRead.value}</span>}
          </p>
        </div>
      </a>
    </div>
  )}
</section>
<style>
  .di { background: var(--white); padding: calc(var(--nav-h) + 72px) 0 40px; }
  .di-top { display: flex; justify-content: space-between; align-items: end; gap: 40px; flex-wrap: wrap; }
  .di :global(.di-line) { margin-top: 20px; max-width: 34ch; font-size: var(--lead); }
  .di-now { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; margin-top: 28px; font-size: var(--size-s); }
  .di-now-tag { font-family: var(--font-display); font-weight: 700; padding: 4px 10px; border-radius: var(--pill); background: var(--black); color: var(--white); font-size: var(--size-xs); }
  .di-now time { color: var(--muted); font-variant-numeric: tabular-nums; }
  .di-now-text { flex-basis: 100%; max-width: 52ch; font-size: var(--size-m); }
  @media (min-width: 620px) { .di-now-text { flex-basis: auto; } }
  .raw-next { border-color: var(--black); border-width: 2px; }
  .raw { max-width: 380px; padding: 24px; border: 1px solid var(--hairline); border-radius: var(--radius-m); }
  .raw :global(h2) { font-size: 1.125rem; }
  .raw :global(.raw-text) { margin-top: 8px; font-size: var(--size-s); color: var(--muted); }
  .raw-link { display: inline-block; margin-top: 12px; font-family: var(--font-display); font-weight: 700; font-size: var(--size-s); }
  .feat { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 56px; align-items: center; margin-top: var(--space-8); text-decoration: none; }
  .feat-label { display: flex; align-items: center; gap: 10px; font-family: var(--font-display); font-weight: 700; font-size: var(--size-s); }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--sun); }
  .feat-title { margin-top: 14px; font-family: var(--font-display); font-weight: 900; font-size: var(--size-xl); line-height: 0.98; letter-spacing: var(--track-display); text-wrap: balance; }
  .feat:hover .feat-title { text-decoration: underline; text-decoration-color: var(--sun); text-decoration-thickness: 0.06em; text-underline-offset: 0.1em; }
  .feat-ex { margin-top: 16px; color: var(--muted); font-size: var(--lead); }
  .feat-meta { display: flex; gap: 14px; align-items: center; margin-top: 18px; font-size: var(--size-xs); font-weight: 500; }
  @media (max-width: 900px) { .feat { grid-template-columns: 1fr; gap: 24px; } }
</style>
