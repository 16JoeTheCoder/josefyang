---
import T from "../../components/T.astro";
import Img from "../../components/Img.astro";
import Icon from "../../components/Icon.astro";
import type { Content } from "../../core/fields";
import mod from "./module";

interface Props { content: Content<typeof mod.fields> }
const { content: c } = Astro.props;
const F = mod.fields;
const editMode = Astro.locals.mode === "draft";
const complete = (value: string) => value.trim() && !/^\[.*\]$/s.test(value.trim());
const hasImage = Boolean(c.image.mediaId && c.image.key);
---
{(editMode || (complete(c.heading.value) && complete(c.story.value))) && (
<section class="about-story">
  <div class:list={["wrap", "story-grid", hasImage && "story-with-image"]}>
    <div class="story-copy">
      <T v={c.heading} f={F.heading} as="h2" class="story-title" />
      <T v={c.story} f={F.story} class="story-text" />
      {c.linkUrl && complete(c.linkLabel.value) && <a class="story-link" href={c.linkUrl}>{c.linkLabel.value}<Icon name="arrow-right" size={17} /></a>}
    </div>
    {hasImage && (
      <figure class="story-photo">
        <Img v={c.image} f={F.image} sizes="(max-width: 860px) 92vw, 560px" />
        {complete(c.caption.value) && <figcaption>{c.caption.value}</figcaption>}
      </figure>
    )}
  </div>
</section>
)}
<style>
  .about-story { background: var(--archive-paper); color: var(--workbench); padding-block: var(--section-y); }
  .story-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px; }
  .story-with-image { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(32px, 7vw, 106px); align-items: center; }
  .story-copy { border-top: 1px solid var(--archive-rule); padding-top: 23px; }
  .about-story :global(.story-title) { font-size: clamp(1.9rem, 5vw, 4.6rem); line-height: 1; font-weight: 790; max-width: 18ch; text-wrap: pretty; }
  .about-story :global(.story-text) { margin-top: 22px; color: var(--muted); max-width: 54ch; font-size: var(--lead); }
  .story-link { display: inline-flex; align-items: center; gap: 9px; min-height: 44px; margin-top: 18px; font-family: var(--font-display); font-weight: 700; text-decoration: underline; text-decoration-color: var(--sun); text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .story-link :global(svg) { color: var(--sun); }
  .story-photo :global(.img-slot) { border-radius: 4px; }
  .story-photo figcaption { margin-top: 10px; font-size: var(--size-xs); color: var(--muted); }
  @media (max-width: 800px) { .story-with-image { grid-template-columns: 1fr; } }
</style>
