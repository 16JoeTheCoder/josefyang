---
import { env } from "cloudflare:workers";
import Img from "../../components/Img.astro";
import Icon from "../../components/Icon.astro";
import "../../styles/blog-prose.css";
import type { Content } from "../../core/fields";
import type { PageData } from "../../core/types";
import { mediaBase } from "../../core/media";
import { renderBlocksToHtml, renderBodyToHtml } from "../../core/posts";
import { shortDate } from "../../lib/dates";
import mod from "./module";

interface Props { content: Content<typeof mod.fields>; data: PageData }
const { content: c, data } = Astro.props;
const entry = data.entry;
const entries = data.devlog.filter((item) => item.sites.includes("main"));
const at = entry ? entries.findIndex((item) => item.id === entry.id) : -1;
const newer = at > 0 ? entries[at - 1] : undefined;
const older = at >= 0 ? entries[at + 1] : undefined;
const body = entry ? (entry.blocks ? renderBlocksToHtml(entry.blocks, mediaBase(env.MEDIA_BASE_URL)) : renderBodyToHtml(entry.body)) : "";
const excerpt = entry?.excerpt.trim();
const showLead = excerpt && entry?.body.trim() !== excerpt;
const failed = data.settings.site.failedPill.value;
---
{entry && (
  <article class="log-post" data-devlog-post>
    <div class="post-band">
      <div class="wrap post-head">
        <a class="post-back" href={`/devlog#log-entry-${entry.slug}`} data-post-context><Icon name="arrow-left" size={17} />{c.back.value}</a>
        <h1>{entry.title}</h1>
        <div class="post-meta">
          <time datetime={entry.date}>{shortDate(entry.date)}</time>
          <span>{entry.type === "note" ? c.noteLabel.value : c.articleLabel.value}</span>
          {(entry.categoryTerms ?? []).map((term) => <a href={"/devlog?category=" + encodeURIComponent(term.slug) + "#devlog-archive"}>{term.name}</a>)}
          {entry.readMinutes && <span>{entry.readMinutes} {c.minRead.value}</span>}
          {entry.build && <a href={`/builds/${entry.build.slug}`}>{entry.build.failed ? `${failed}: ${entry.build.title}` : entry.build.title}<Icon name="arrow-right" size={15} /></a>}
        </div>
      </div>
    </div>

    <div class="post-paper">
      {entry.hero?.mediaId && <figure class="wrap post-cover"><Img v={entry.hero} f={{ ratio: "2 / 1", empty: c.photoEmpty.value }} eager sizes="(max-width: 950px) 92vw, 980px" /></figure>}
      <div class="wrap post-reading">
        {showLead && <p class="post-lead">{excerpt}</p>}
        {body && <div class="bp" set:html={body} />}
        {!entry.blocks && entry.images.some((image) => image.mediaId) && (
          <div class="post-gallery">{entry.images.filter((image) => image.mediaId).map((image) => <Img v={image} f={{ ratio: "4 / 3", empty: c.photoEmpty.value }} sizes="(max-width: 580px) 92vw, 360px" />)}</div>
        )}
        {entry.tags.length > 0 && <ul class="post-tags">{entry.tags.map((tag) => <li>{tag}</li>)}</ul>}
        {entry.build && <div class="post-references">
          {entry.build && <a href={`/builds/${entry.build.slug}`}>{c.buildLink.value}<Icon name="arrow-right" size={17} /></a>}
        </div>}
      </div>
      {(older || newer) && <nav class="wrap post-nav" aria-label={c.navLabel.value}>
        {older && <a href={`/devlog/${older.slug}`} data-post-context><span>{c.previous.value}</span><strong>{older.title}</strong></a>}
        {newer && <a class="post-next" href={`/devlog/${newer.slug}`} data-post-context><span>{c.next.value}</span><strong>{newer.title}</strong></a>}
      </nav>}
    </div>
  </article>
)}
<script>
  import { onPage } from "../../core/island";
  onPage("[data-devlog-post]", (root) => {
    const params = new URLSearchParams(location.search);
    if (!params.size) return;
    for (const link of root.querySelectorAll<HTMLAnchorElement>("[data-post-context]")) {
      const destination = new URL(link.href);
      for (const key of ["q", "project", "type", "category", "tag"]) {
        const value = params.get(key);
        if (value) destination.searchParams.set(key, value);
      }
      link.href = destination.href;
    }
  });
</script>
<style>
  .log-post { color: var(--workbench); background: var(--archive-paper); }
  .post-band { padding: calc(var(--nav-h) + 49px) 0 clamp(32px, 7vw, 92px); background: var(--workbench); color: var(--workbench-ink); }
  .post-back { display: inline-flex; align-items: center; gap: 9px; min-height: 44px; font: 650 var(--size-s)/1.2 var(--font-display); text-decoration: none; }
  .post-back :global(.icon), .post-meta a :global(.icon), .post-references a :global(.icon) { color: var(--sun); }
  .post-back:hover, .post-meta a:hover, .post-references a:hover, .post-nav a:hover strong { text-decoration: underline; text-underline-offset: 5px; text-decoration-color: var(--sun); }
  .post-head h1 { margin-top: 16px; max-width: 21ch; font: 840 clamp(2.7rem, 7.7vw, 6rem)/.97 var(--font-display); letter-spacing: var(--track-tight); text-wrap: balance; }
  .post-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 14px; margin-top: clamp(16px, 3vw, 30px); color: var(--workbench-subtle); font-size: var(--size-s); }
  .post-meta time { font-variant-numeric: tabular-nums; }
  .post-meta > :not(:first-child) { padding-left: 14px; border-left: 1px solid var(--workbench-rule); }
  .post-meta a { display: inline-flex; align-items: center; gap: 7px; color: var(--workbench-ink); text-decoration: none; }
  .post-paper { padding: clamp(28px, 6vw, 85px) 0 clamp(58px, 9vw, 135px); }
  .post-cover { max-width: calc(1010px + 2 * var(--gutter)); margin-bottom: clamp(30px, 5vw, 72px); }
  .post-cover :global(.img-slot) { border-radius: 4px; }
  .post-cover :global(.img-fit) { background: var(--section); }
  .post-reading { max-width: calc(710px + 2 * var(--gutter)); }
  .post-lead { color: var(--workbench); font-size: clamp(1.22rem, 2.1vw, 1.55rem); font-weight: 560; line-height: 1.55; padding-bottom: 24px; border-bottom: 1px solid var(--archive-rule); margin-bottom: 25px; max-width: 62ch; }
  .post-reading :global(.bp) { overflow-wrap: anywhere; }
  .post-reading :global(.bp pre) { overflow-wrap: normal; background: var(--workbench); color: var(--workbench-ink); }
  .post-reading :global(.bp blockquote) { border-left-width: 1px; }
  .post-reading :global(.bp code:not(pre code)) { background: var(--section); }
  .post-gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 32px; gap: 14px; }
  .post-tags { display: flex; flex-wrap: wrap; gap: 8px 14px; margin-top: 28px; color: var(--muted); font-size: var(--size-s); }
  .post-tags li + li { padding-left: 14px; border-left: 1px solid var(--archive-rule); }
  .post-references { display: flex; flex-wrap: wrap; gap: 0 20px; margin-top: 28px; padding-top: 8px; border-top: 1px solid var(--archive-rule); }
  .post-references a { display: inline-flex; gap: 7px; align-items: center; min-height: 44px; text-decoration: none; font-weight: 700; font-family: var(--font-display); font-size: var(--size-s); }
  .post-nav { display: flex; justify-content: space-between; gap: clamp(16px, 5vw, 70px); margin-top: clamp(38px, 7vw, 95px); }
  .post-nav a { flex: 1 1 0; display: grid; align-content: start; gap: 8px; padding-top: 18px; border-top: 1px solid var(--archive-rule); text-decoration: none; }
  .post-nav a span { color: var(--muted); font-size: var(--size-xs); }
  .post-nav a strong { font: 760 clamp(1rem, 2.2vw, 1.55rem)/1.15 var(--font-display); letter-spacing: var(--track-display); }
  .post-nav a.post-next { text-align: end; }
  @media (max-width: 580px) {
    .post-band { padding-top: calc(var(--nav-h) + 38px); }
    .post-meta > :not(:first-child) { padding-left: 8px; }
    .post-meta { gap: 4px 8px; }
    .post-gallery { grid-template-columns: 1fr; }
  }
</style>
