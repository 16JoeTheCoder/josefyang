---
import T from "../../components/T.astro";
import type { Content } from "../../core/fields";
import { buildFields } from "../../core/build-fields";
import type { PageData } from "../../core/types";
import mod from "./module";
interface Props { content: Content<typeof mod.fields>; data: PageData }
const { content: c, data } = Astro.props;
const b = data.build;
const metaSection = data.mode === "draft" ? "build-meta" : undefined;
const metaPath = (path: string) => metaSection ? path : undefined;
---
{b && (
  <section class="bh">
    <div class="wrap">
      {b.meta.status === "failed" && <span class="pill pill-failed">{data.settings.site.failedPill.value}</span>}
      <div data-edit-section={metaSection}><T v={b.meta.title} f={buildFields.title} as="h1" class="bh-title" editPath="title" /></div>
      <dl class="facts">
        <div><T v={c.typeLabel} f={mod.fields.typeLabel} as="dt" editPath="typeLabel" /><dd data-edit-section={metaSection} data-edit-path={metaPath("kind")}>{b.meta.kind === "software" ? c.software.value : c.hardware.value}</dd></div>
        <div><T v={c.builtLabel} f={mod.fields.builtLabel} as="dt" editPath="builtLabel" /><dd data-edit-section={metaSection} data-edit-path={metaPath("built")}>{b.meta.built.value}</dd></div>
        <div><T v={c.madeWithLabel} f={mod.fields.madeWithLabel} as="dt" editPath="madeWithLabel" /><dd data-edit-section={metaSection} data-edit-path={metaPath("madeWith")}>{b.meta.madeWith.value}</dd></div>
        <div><T v={c.linksLabel} f={mod.fields.linksLabel} as="dt" editPath="linksLabel" /><dd data-edit-section={metaSection} data-edit-path={metaPath("links")}>{b.meta.links.length ? b.meta.links.map((l, i) => <a class="link-u" href={l.url} target={l.url.startsWith("http") ? "_blank" : undefined} rel="noopener" data-edit-path={metaPath(`links[${i}].label`)}>{l.label.value}</a>) : "-"}</dd></div>
      </dl>
    </div>
  </section>
)}
<style>
  .bh { background: var(--white); padding: calc(var(--nav-h) + 80px) 0 40px; }
  .bh .pill { margin-bottom: 20px; }
  .bh :global(.bh-title) { font-stretch: 90%; overflow-wrap: anywhere; }
  .facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; margin: 48px 0 0; padding-top: 20px; border-top: 2px solid var(--black); }
  .facts dt { font-size: var(--size-s); color: var(--muted); }
  .facts dd { margin: 4px 0 0; font-family: var(--font-display); font-weight: 700; display: flex; flex-wrap: wrap; gap: 4px 16px; }
  @media (max-width: 720px) { .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
