---
import T from "../../components/T.astro";
import Img from "../../components/Img.astro";
import Icon from "../../components/Icon.astro";
import type { Content, ImageValue } from "../../core/fields";
import { buildFields } from "../../core/build-fields";
import type { PageData } from "../../core/types";
import mod from "./module";

interface Props { content: Content<typeof mod.fields>; data: PageData; sectionId?: string }
const { content: c, data, sectionId = "about-timeline" } = Astro.props;
const F = mod.fields;
const text = (value?: string) => value?.trim() ?? "";
const hasImage = (value?: ImageValue): value is ImageValue => Boolean(value?.mediaId && value?.key);
const compare = (value: string) => value.trim().toLowerCase();
const milestones = data.milestones.filter((item) => text(item.title) && !/^\[.*\]$/s.test(text(item.title)) && !/^filler$/i.test(text(item.label)));
const entries = milestones.map((milestone, index) => {
  const assets = c.evidence.find((item) => compare(item.milestone.value) === compare(milestone.title));
  const build = data.builds.find((item) => compare(item.meta.title.value) === compare(milestone.title));
  const image = hasImage(assets?.image) ? assets?.image : hasImage(build?.meta.selectorImage) ? build?.meta.selectorImage : undefined;
  const href = assets?.url || (build ? "/builds/" + build.slug : "");
  const linkLabel = assets?.linkLabel.value || (build ? build.meta.title.value : c.evidenceLink.value);
  const date = /^\d{4}-\d{2}-\d{2}$/.test(milestone.date) ? milestone.date : undefined;
  return { ...milestone, date, image, href, linkLabel, panelId: sectionId + "-evidence-" + index };
});
const showFigure = hasImage(c.figure);
---
{(entries.length > 0 || Astro.locals.mode === "draft") && (
<section class="about-timeline" aria-labelledby={sectionId + "-heading"} data-about-timeline>
  <div class="wrap">
    <div class="timeline-header">
      <div>
        <T v={c.heading} f={F.heading} as="h2" class="timeline-title" id={sectionId + "-heading"} />
        <T v={c.line} f={F.line} class="timeline-intro" />
      </div>
      {showFigure && <figure class="timeline-cameo"><Img v={c.figure} f={F.figure} sizes="95px" /></figure>}
    </div>
    {entries.length > 0 && (
      <div class="timeline-grid">
        <ol class="timeline-list" data-timeline-list>
          {entries.map((entry, index) => (
            <li class="timeline-entry" data-timeline-item>
              <div class="timeline-row">
                {entry.date ? <time datetime={entry.date} class="timeline-date">{entry.label || entry.date}</time> : <span class="timeline-date">{entry.label}</span>}
                <h3>
                  <span class="timeline-static-title">{entry.title}</span>
                  <button type="button" data-timeline-select aria-pressed={index === 0 ? "true" : "false"} aria-controls={entry.panelId}>
                    {entry.title}<Icon name="arrow-right" size={17} />
                  </button>
                </h3>
              </div>
              <div class="timeline-inline">
                {entry.body && <p>{entry.body}</p>}
                {entry.image && <Img v={entry.image} f={buildFields.selectorImage} sizes="(max-width: 800px) 90vw, 590px" />}
                {entry.href && <a class="timeline-link" href={entry.href}>{entry.linkLabel}<Icon name="arrow-right" size={16} /></a>}
              </div>
            </li>
          ))}
        </ol>
        <aside class="timeline-evidence" data-timeline-evidence>
          {entries.map((entry, index) => (
            <article id={entry.panelId} data-timeline-panel hidden={index !== 0}>
              {entry.image && <Img v={entry.image} f={buildFields.selectorImage} sizes="(max-width: 800px) 90vw, 500px" />}
              <div class="timeline-evidence-copy">
                <h3>{entry.title}</h3>
                {entry.body && <p>{entry.body}</p>}
                {entry.href && <a class="timeline-link" href={entry.href}>{entry.linkLabel}<Icon name="arrow-right" size={16} /></a>}
                {entry.date ? <time datetime={entry.date}>{entry.label || entry.date}</time> : <span class="evidence-date">{entry.label}</span>}
              </div>
            </article>
          ))}
        </aside>
      </div>
    )}
  </div>
</section>
)}
<script>
  import { onPage } from "../../core/island";
  import { mountTimeline } from "./island";
  onPage("[data-about-timeline]", mountTimeline);
</script>
<style>
  .about-timeline { background: var(--archive-paper); color: var(--workbench); padding-bottom: clamp(48px, 7vw, 92px); }
  .timeline-header { display: flex; justify-content: space-between; gap: 24px; align-items: end; padding-block: clamp(26px, 4vw, 48px) clamp(24px, 3vw, 38px); border-top: 1px solid var(--archive-rule); }
  .about-timeline :global(.timeline-title) { font-size: clamp(2.2rem, 5.1vw, 4.9rem); font-weight: 780; line-height: 1; letter-spacing: var(--track-tight); }
  .about-timeline :global(.timeline-intro) { color: var(--muted); margin-top: 9px; }
  .timeline-cameo { width: clamp(48px, 9vw, 94px); flex: none; }
  .timeline-cameo :global(.img-slot) { border-radius: 3px; }
  .timeline-grid { display: grid; gap: 24px; align-items: start; }
  .timeline-list { border-top: 1px solid var(--archive-rule); }
  .timeline-entry { border-bottom: 1px solid var(--archive-rule); }
  .timeline-row { display: grid; grid-template-columns: minmax(86px, .31fr) minmax(0, 1fr); gap: 12px; min-height: 77px; align-items: center; }
  .timeline-date { color: var(--muted); font-size: var(--size-s); font-variant-numeric: tabular-nums; }
  .timeline-row h3 { min-width: 0; font-family: var(--font-display); font-size: clamp(1rem, 2vw, 1.5rem); font-weight: 710; line-height: 1.18; letter-spacing: var(--track-display); overflow-wrap: anywhere; }
  .timeline-row button { display: none; }
  .timeline-inline { padding: 0 0 21px; color: var(--muted); }
  .timeline-inline > p { max-width: var(--measure); }
  .timeline-inline :global(.img-slot) { max-width: 590px; margin-top: 13px; border-radius: 4px; }
  .timeline-link { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; font: 650 var(--size-s) var(--font-display); text-decoration: underline; text-decoration-color: var(--sun); overflow-wrap: anywhere; }
  .timeline-link :global(svg) { flex: none; }
  .timeline-link:hover { text-decoration-color: currentColor; }
  .timeline-evidence { display: none; }

  @media (min-width: 801px) and (min-height: 600px) {
    .about-timeline[data-ready] .timeline-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(30px, 6vw, 82px); }
    .about-timeline[data-ready] .timeline-inline, .about-timeline[data-ready] .timeline-static-title { display: none; }
    .about-timeline[data-ready] .timeline-row button { display: flex; justify-content: space-between; align-items: center; gap: 14px; padding: 12px 12px 12px 0; width: 100%; min-height: 66px; border: 0; background: transparent; text-align: left; cursor: pointer; }
    .timeline-row button :global(svg) { color: var(--muted); flex: none; transition: transform var(--dur-fast) var(--ease-out); }
    .timeline-row button:hover :global(svg), .timeline-row button[aria-pressed="true"] :global(svg) { color: var(--workbench); transform: translateX(4px); }
    .about-timeline[data-ready] .timeline-entry:has(button[aria-pressed="true"]) { background: color-mix(in srgb, var(--white) 46%, var(--archive-paper)); box-shadow: inset 0 -1px var(--sun); }
    .about-timeline[data-ready] .timeline-evidence { display: block; position: sticky; top: calc(var(--nav-h) + 24px); }
    .timeline-evidence article { background: var(--workbench); color: var(--workbench-ink); padding: clamp(18px, 3vw, 32px); border-radius: 4px; }
    .timeline-evidence article:not([hidden]) { animation: evidence-in 280ms var(--ease-out); }
    .timeline-evidence article :global(.img-slot) { border-radius: 3px; margin-bottom: 20px; max-height: 245px; }
    .timeline-evidence-copy { position: relative; padding-top: 14px; }
    .timeline-evidence-copy::before { content: ""; position: absolute; width: 25px; height: 2px; background: var(--sun); top: 0; left: 0; }
    .timeline-evidence h3 { font: 750 clamp(1.3rem, 2.2vw, 2rem)/1.07 var(--font-display); letter-spacing: var(--track-display); overflow-wrap: anywhere; }
    .timeline-evidence p { margin-top: 10px; color: var(--workbench-subtle); }
    .timeline-evidence time, .timeline-evidence .evidence-date { display: block; color: var(--workbench-subtle); margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--workbench-rule); font-size: var(--size-xs); }
    .timeline-evidence time:empty, .timeline-evidence .evidence-date:empty { display: none; }
    @keyframes evidence-in { from { opacity: .65; translate: 0 5px; } to { opacity: 1; translate: 0 0; } }
  }
</style>
