---
import T from "../../components/T.astro";
import Img from "../../components/Img.astro";
import Icon from "../../components/Icon.astro";
import type { Content } from "../../core/fields";
import type { PageData } from "../../core/types";
import { shortDate } from "../../lib/dates";
import mod from "./module";

interface Props { content: Content<typeof mod.fields>; data: PageData; sectionId: string }
const { content: c, data, sectionId } = Astro.props;
const entries = data.devlog.filter((entry) => entry.sites.includes("main") && (entry.status === "published" || data.mode === "draft")).slice(0, 10);
const firstCover = entries.findIndex((entry) => entry.hero?.mediaId);
const slot = { ratio: "3 / 2", empty: c.photoEmpty.value };
---
<section class="journal" data-journal aria-labelledby={sectionId + "-h"}>
  <div class="wrap journal-grid">
    <header class="journal-head">
      <T v={c.heading} f={mod.fields.heading} as="h2" id={sectionId + "-h"} editPath="heading" />
      <T v={c.line} f={mod.fields.line} class="journal-intro" editPath="line" />
      <a class="journal-link" href="/devlog" data-edit-path={Astro.locals.mode === "draft" ? "button" : undefined}>{c.button.value}<Icon name="arrow-right" size={17} /></a>
      {firstCover >= 0 && <div class="journal-media" data-journal-media aria-hidden="true">
        {entries.map((entry, i) => entry.hero?.mediaId && <figure data-journal-preview={i} class:list={["journal-photo", i === firstCover && "is-current"]}>
          <Img v={entry.hero} f={slot} sizes="(max-width: 720px) 0px, 480px" />
        </figure>)}
      </div>}
    </header>
    {entries.length === 0 ? (
      <div class="journal-empty">
        <T v={c.emptyNote} f={mod.fields.emptyNote} />
      </div>
    ) : (
      <ol class="journal-list">
        {entries.map((entry) => (
          <li data-journal-entry>
            <a href={`/devlog/${entry.slug}`}>
              <time datetime={entry.date}>{shortDate(entry.date)}</time>
              <div>
                <h3>{entry.title}</h3>
                {entry.build && <p>{entry.build.title}</p>}
              </div>
              <Icon name="arrow-right" size={19} />
            </a>
          </li>
        ))}
      </ol>
    )}
  </div>
</section>
<script>
  import { onPage } from "../../core/island";

  onPage("[data-journal]", (root) => {
    const entries = [...root.querySelectorAll<HTMLElement>("[data-journal-entry]")];
    const media = root.querySelector<HTMLElement>("[data-journal-media]");
    if (!entries.length) return;
    const previews = [...root.querySelectorAll<HTMLElement>("[data-journal-preview]")];

    let frame = 0;
    let current = -1;

    function update() {
      frame = 0;

      const top = window.innerHeight * .42;
      let index = 0;
      entries.forEach((entry, i) => { if (entry.getBoundingClientRect().top <= top) index = i; });
      if (current === index) return;
      current = index;
      const previewIndex = previews.findLastIndex((preview) => Number(preview.dataset.journalPreview) <= index);
      if (media) media.hidden = previewIndex < 0;
      previews.forEach((preview, i) => preview.classList.toggle("is-current", i === previewIndex));
      entries.forEach((entry, i) => entry.toggleAttribute("data-current", i === index));
    }

    function schedule() { if (!frame) frame = requestAnimationFrame(update); }
    update();
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);
    return () => {
      cancelAnimationFrame(frame);
      window.removeEventListener("scroll", schedule);
      window.removeEventListener("resize", schedule);
    };
  });
</script>
<style>
  .journal { background: var(--archive-paper); color: var(--workbench); padding-block: clamp(66px, 9vw, 132px); }
  .journal-grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(40px, 8vw, 128px); align-items: start; }
  .journal-head { align-self: start; }
  .journal-head :global(h2) { font-size: clamp(2.4rem, 5.7vw, 5.7rem); font-weight: 780; letter-spacing: var(--track-tight); }
  .journal-head :global(.journal-intro) { margin-top: 13px; color: var(--muted); line-height: 1.55; }
  .journal-link { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; border-bottom: 1px solid var(--archive-rule); text-decoration: none; font: 680 var(--size-s) var(--font-display); margin-top: 10px; }
  .journal-link:hover { border-color: var(--sun); }
  .journal-media { display: grid; margin-top: 25px; aspect-ratio: 3 / 2; }
  .journal-media[hidden] { display: none; }
  .journal-photo { grid-area: 1 / 1; visibility: hidden; opacity: 0; }
  .journal-photo.is-current { opacity: 1; visibility: visible; }
  .journal-photo :global(.img-slot) { border-radius: var(--radius-s); }
  .journal-list { border-top: 1px solid var(--archive-rule); }
  .journal-list li { border-bottom: 1px solid var(--archive-rule); }
  .journal-list a { min-height: 96px; padding: 18px 5px; display: grid; grid-template-columns: 11ch 1fr auto; gap: 16px; align-items: center; text-decoration: none; }
  .journal-list li[data-current] a { background: color-mix(in srgb, var(--white), transparent 70%); }
  .journal-list a:hover h3 { text-decoration: underline; text-decoration-color: var(--sun); text-underline-offset: 4px; }
  .journal-list a :global(svg) { color: var(--muted); }
  .journal-list li[data-current] a :global(svg), .journal-list a:hover :global(svg) { color: var(--workbench); }
  .journal-list time, .journal-list p { font-size: var(--size-xs); color: var(--muted); line-height: 1.35; }
  .journal-list time { font-variant-numeric: tabular-nums; }
  .journal-list h3 { font-family: var(--font-display); font-weight: 720; font-size: clamp(1rem, 2vw, 1.4rem); line-height: 1.2; }
  .journal-list p { margin-top: 4px; }
  .journal-empty { color: var(--muted); }
  @media (min-width: 721px) and (min-height: 620px) { .journal-head { position: sticky; top: 52px; } }
  @media (max-width: 720px) {
    .journal-grid { grid-template-columns: 1fr; gap: 25px; }
    .journal-media { display: none; }
    .journal-list a { min-height: 78px; grid-template-columns: 1fr auto; gap: 5px 12px; padding: 12px 0; }
    .journal-list time { grid-column: 1; }
    .journal-list a div { grid-column: 1; }
    .journal-list a :global(svg) { grid-column: 2; grid-row: 1 / span 2; }
  }
</style>
