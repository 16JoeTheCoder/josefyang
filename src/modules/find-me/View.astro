---
import T from "../../components/T.astro";
import Icon from "../../components/Icon.astro";
import type { Content } from "../../core/fields";
import type { PageData } from "../../core/types";
import mod from "./module";
interface Props { content: Content<typeof mod.fields>; data: PageData }
const { content: c, data } = Astro.props;
const ct = data.settings.contacts;
const primary = [{ url: ct.instagram, label: ct.instagramLabel.value, icon: "instagram" }, { url: ct.github, label: ct.githubLabel.value, icon: "github" }].filter((l) => l.url);
const secondary = [{ url: ct.youtube, label: ct.youtubeLabel.value, icon: "youtube" }, { url: ct.linkedin, label: ct.linkedinLabel.value, icon: "linkedin" }].filter((l) => l.url);
---
{(primary.length > 0 || secondary.length > 0) && (
  <section class="fm on-sun">
    <div class="wrap">
      <T v={c.heading} f={mod.fields.heading} as="h2" />
      <ul class="fm-row">
        {primary.map((l) => <li><a class="btn btn-primary btn-lg" href={l.url} target="_blank" rel="noopener me"><Icon name={l.icon} size={20} />{l.label}</a></li>)}
        {secondary.map((l) => <li><a class="btn btn-secondary" href={l.url} target="_blank" rel="noopener me"><Icon name={l.icon} size={18} />{l.label}</a></li>)}
      </ul>
      {secondary.some((l) => l.icon === "youtube") && <T v={c.note} f={mod.fields.note} class="fm-note" />}
    </div>
  </section>
)}
<style>
  .fm { background: var(--sun); padding: 48px 0 var(--section-y); }
  .fm-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 28px; }
  .fm :global(.fm-note) { margin-top: 16px; color: var(--sun-ink); }
</style>
