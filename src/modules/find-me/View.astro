---
import T from "../../components/T.astro";
import Icon from "../../components/Icon.astro";
import type { Content } from "../../core/fields";
import type { PageData } from "../../core/types";
import mod from "./module";

interface Props { content: Content<typeof mod.fields>; data: PageData }
const { content: c, data } = Astro.props;
const ct = data.settings.contacts;
const links = [
  { url: ct.instagram, label: ct.instagramLabel.value, icon: "instagram" },
  { url: ct.github, label: ct.githubLabel.value, icon: "github" },
  { url: ct.youtube, label: ct.youtubeLabel.value, icon: "youtube" },
  { url: ct.linkedin, label: ct.linkedinLabel.value, icon: "linkedin" },
].filter((link) => link.url);
---
{links.length > 0 && (
<section class="about-social">
  <div class="wrap">
    <div class="social-line">
      <T v={c.heading} f={mod.fields.heading} as="h2" class="social-title" />
      <ul class="social-links">
        {links.map((link) => (
          <li><a href={link.url} target="_blank" rel="noopener me"><Icon name={link.icon} size={18} />{link.label}</a></li>
        ))}
      </ul>
      {links.some((link) => link.icon === "youtube") && <T v={c.note} f={mod.fields.note} class="social-note" />}
    </div>
  </div>
</section>
)}
<style>
  .about-social { background: var(--workbench-mat); color: var(--workbench-ink); padding-bottom: clamp(26px, 5vw, 60px); }
  .social-line { display: flex; align-items: baseline; gap: 0 25px; flex-wrap: wrap; padding-top: 12px; border-top: 1px solid var(--workbench-rule); }
  .about-social :global(.social-title) { font-size: var(--size-m); font-weight: 670; letter-spacing: 0; color: var(--workbench-subtle); line-height: 1.2; }
  .social-links { display: flex; flex-wrap: wrap; gap: 0 17px; align-items: center; min-width: 0; }
  .social-links a { display: inline-flex; align-items: center; min-height: 44px; gap: 8px; font: 660 var(--size-s) var(--font-display); text-decoration: none; }
  .social-links a:hover { text-decoration: underline; text-decoration-color: var(--sun); }
  .social-links :global(svg) { color: var(--workbench-subtle); flex: none; }
  .about-social :global(.social-note) { flex: 1 1 100%; color: var(--workbench-subtle); font-size: var(--size-xs); }
</style>

