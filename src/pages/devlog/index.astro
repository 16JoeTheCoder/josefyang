---
import { env } from "cloudflare:workers";
import Base from "../../layouts/Base.astro";
import RenderSections from "../../core/RenderSections.astro";
import { loadPageData } from "../../core/db";
const { data, sections } = await loadPageData(env.DB, Astro.locals.mode, "devlog");
---
<Base settings={data.settings} active="devlog" title="Devlog">
  <RenderSections page="devlog" sections={sections} data={data} />
</Base>
