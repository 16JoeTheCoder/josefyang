---
import { env } from "cloudflare:workers";
import Base from "../layouts/Base.astro";
import { loadPageData } from "../core/db";
const { data } = await loadPageData(env.DB, "published");
Astro.response.status = 404;
---
<Base settings={data.settings} title="Not found">
  <section class="nf ground-granite">
    <div class="wrap">
      <h1 class="r-giant">{data.settings.site.notFoundTitle.value}</h1>
      <p class="r-body">{data.settings.site.notFoundText.value}</p>
      <a class="btn btn-primary" href="/projects">{data.settings.site.footerProjectsButton.value}</a>
    </div>
  </section>
</Base>
<style>
  .nf { padding: calc(var(--nav-h) + 120px) 0 var(--section-y); min-height: 70svh; }
  .nf p { margin: 24px 0 32px; }
</style>
