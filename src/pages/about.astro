---
import { env } from "cloudflare:workers";
import Base from "../layouts/Base.astro";
import RenderSections from "../core/RenderSections.astro";
import { loadPageData } from "../core/db";
const { data, sections } = await loadPageData(env.DB, Astro.locals.mode, "about");
---
<Base settings={data.settings} active="about" title="About">
  <RenderSections page="about" sections={sections} data={data} />
</Base>
