---
import { env } from "cloudflare:workers";
import Base from "../layouts/Base.astro";
import { views } from "../core/views/home";
import RenderSections from "../core/RenderSections.astro";
import { loadPageData } from "../core/db";
const { data, sections } = await loadPageData(env.DB, Astro.locals.mode, "home");
---
<Base settings={data.settings} active="home">
  <RenderSections page="home" sections={sections} data={data} views={views} />
</Base>
