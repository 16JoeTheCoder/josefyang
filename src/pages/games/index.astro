---
/** Main-site Games journey (portfolio). The catalog lives on GAME_HOST (or /hub locally): src/lib/game-host.ts. */
import { env } from "cloudflare:workers";
import Base from "../../layouts/Base.astro";
import { views } from "../../core/views/games";
import RenderSections from "../../core/RenderSections.astro";
import { loadPageData } from "../../core/db";
import { SITE_URL } from "../../core/posts";
const { data, sections } = await loadPageData(env.DB, Astro.locals.mode, "games");
const siteUrl = (env.SITE_URL || SITE_URL).replace(/\/$/, "");
---
<Base settings={data.settings} active="games" title={data.settings.site.navGames.value} canonical={`${siteUrl}/games`}>
  <RenderSections page="games" sections={sections} data={data} views={views} />
</Base>
