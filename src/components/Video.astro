---
/**
 * One short clip with a poster. The poster image is shown; the clip loads and plays only on click
 * (preload none, native controls). Without JS the play control is a plain link to the file.
 * The island that wires it is `mountVideo` in ./showcase/video.ts.
 */
import { env } from "cloudflare:workers";
import type { ImageField, ImageValue, VideoValue } from "../core/fields";
import { mediaBase } from "../core/media";
import Img from "./Img.astro";
interface Props {
  v: VideoValue | null | undefined;
  poster: ImageValue;
  posterField: Pick<ImageField, "ratio" | "empty">;
  playLabel: string;
  failLabel?: string;
  sizes?: string;
  class?: string;
}
const { v, poster, posterField, playLabel, failLabel = "", sizes = "(max-width: 900px) 92vw, 1200px", class: cls = "" } = Astro.props;
const base = mediaBase(env.MEDIA_BASE_URL);
const src = v && v.mediaId && v.key && v.original ? `${base}/${v.key}/${v.original}` : "";
---
<div class:list={["video", cls]} data-video-root style={`--ratio:${posterField.ratio}`}>
  <div class="video-stage">
    <Img v={poster} f={posterField} sizes={sizes} class="video-poster" />
    {src && <video controls playsinline preload="none" data-video data-src={src} aria-label={v?.alt || undefined} hidden></video>}
    {src && <a class="btn btn-primary video-play" data-play href={src}><span class="video-icon" aria-hidden="true"></span>{playLabel}</a>}
  </div>
  <p class="sr-only" role="status" data-video-status data-fail={failLabel}></p>
</div>
<style>
  .video-stage { position: relative; border-radius: var(--radius-m); overflow: hidden; background: var(--tile); }
  .video-stage :global(.video-poster) { border-radius: 0; }
  .video-stage video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; background: var(--black); }
  .video-stage video[hidden] { display: none; }
  .video-play { position: absolute; right: var(--space-4); bottom: var(--space-4); min-height: 48px; padding: 0 var(--space-5); }
  .video-icon { width: 0; height: 0; border: 6px solid transparent; border-left: 9px solid currentColor; border-right: 0; }
  .video-play[hidden] { display: none; }
  @media (max-width: 560px) {
    .video-play { right: var(--space-3); bottom: var(--space-3); padding: 0 var(--space-4); font-size: var(--size-xs); min-height: 44px; }
  }
</style>
