    "@astrojs/preact": "^6.1.6",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.1",
    "@tiptap/core": "^3.35.0",
    "@tiptap/extensions": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "astro": "^7.4.12",
    "fflate": "^0.8.3",
    "gsap": "^3.15.1",
    "preact": "^11.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261116.1",
