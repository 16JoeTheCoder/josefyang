{
  "name": "josefyang",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "check": "astro check",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply josefyang-db --local",
