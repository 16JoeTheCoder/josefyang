{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "josefyang-site",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker.ts",
  // Weekly D1 backup to R2 (Sunday 02:00 Jakarta time). Restore: see README.
  "triggers": { "crons": ["0 19 * * 6"] },
  "assets": { "binding": "ASSETS", "directory": "./dist" },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "josefyang-db",
      // Replace with the id printed by `npx wrangler d1 create josefyang-db` (see README).
      "database_id": "52db133e-d5e3-4e95-9f68-c994ab79c26b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "josefyang-media" }],
  "vars": {
    "ADMIN_EMAIL": "josefyang.official@gmail.com,josef@josefyang.com,josefdanielyang@gmail.com",
    "CACHE_PAGES": "1",
    // Empty = images are served by this Worker at /media/*. Set to "https://media.josefyang.com" once the R2 custom domain exists.
    "MEDIA_BASE_URL": ""
  }
  // Secrets (never in this file): CF_ACCESS_AUD, CF_ACCESS_TEAM_DOMAIN, CF_ANALYTICS_TOKEN
}
